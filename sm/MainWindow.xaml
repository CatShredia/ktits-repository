<Window
    x:Class="CurrencyConverter.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Конвертер валют"
    Width="350"
    Height="250"
    Icon="/valuta.ico">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Label
            Grid.Row="0"
            Grid.Column="0"
            Content="Сумма в рублях:" />
        <TextBox
            Grid.Row="0"
            Grid.Column="1"
            Margin="5"
            Text="{Binding Rubles, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

        <Label
            Grid.Row="1"
            Grid.Column="0"
            Content="Валюта:" />
        <ComboBox
            Grid.Row="1"
            Grid.Column="1"
            Margin="5"
            ItemsSource="{Binding Currencies}"
            SelectedItem="{Binding SelectedCurrency, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

        <Button
            Grid.Row="2"
            Grid.Column="0"
            Grid.ColumnSpan="2"
            Margin="5"
            Command="{Binding ConvertCommand}"
            Content="Конвертировать" />

        <Label
            Grid.Row="3"
            Grid.Column="0"
            Content="Результат:" />
        <TextBox
            Grid.Row="3"
            Grid.Column="1"
            Margin="5"
            IsReadOnly="True"
            Text="{Binding Result}" />
    </Grid>
</Window>