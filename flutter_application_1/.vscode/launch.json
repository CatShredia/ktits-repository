  "version": "0.2.0",
  "configurations": [
    {
      "name": "flutter_application_1 (auto select device)",
      "request": "launch",
      "type": "dart"
    },
    {
      "name": "flutter_application_1 (hot reload)",
      "request": "launch",
      "type": "dart",
      "flutterMode": "debug",
      "toolArgs": ["--hot"]
    },
    {
      "name": "flutter_application_1 (profile mode)",
      "request": "launch",
      "type": "dart",
      "flutterMode": "profile"
    },
    {
      "name": "flutter_application_1 (release mode)",
      "request": "launch",
      "type": "dart",
      "flutterMode": "release"
    },
    {
      "name": "flutter_application_1 (Android physical)",
      "request": "launch",
      "type": "dart",
      "deviceId": "android"
    },
    {
      "name": "flutter_application_1 (iOS physical)",
      "request": "launch",
      "type": "dart",
      "deviceId": "ios"
    }
  ]
}
