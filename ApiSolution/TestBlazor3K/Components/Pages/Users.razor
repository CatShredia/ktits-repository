@page "/users"
@using TestBlazor3K.ApiRequest
@using TestBlazor3K.ApiRequest.Models
@rendermode InteractiveServer

<PageTitle>User List</PageTitle>

<h1>User List</h1>

@if (isLoading)
{
    <p class="text-center">Loading data...</p>
}
else if (users == null || !users.Any())
{
    <p class="text-center text-muted">No users found.</p>
}
else
{
    <table class="table table-bordered">
        <thead class="alert-dark">
        <tr>
            <th>ID</th>
            <th>Name</th>
            <th>Description</th>
        </tr>
        </thead>
        <tbody>
        @foreach (var user in users)
        {
            <tr>
                <td>@user.id_User</td>
                <td>@user.Name</td>
                <td>@user.Description</td> 
            </tr>
        }
        </tbody>
    </table>
}

<hr />

<h1>Add New User</h1>

@if (!string.IsNullOrEmpty(errorMessage))
{
    <div class="alert alert-danger">@errorMessage</div>
}

<div class="d-flex align-items-center h-custom-2 px-5 ms-xl-4 mt-5 pt-5 pt-xl-0 mt-xl-n5">
    @* Use EditForm or standard form with onsubmit *@
    <form style="width: 23rem;" @onsubmit="HandleSubmit">
        <div class="form-outline mb-4">
            <label class="form-label" for="loginInput">Login</label>
            <input type="text" @bind="reqDataUser.Login" id="loginInput" class="form-control form-control-lg" disabled="@isSubmitting"/>
        </div>
        <div class="form-outline mb-4">
            <label class="form-label" for="passwordInput">Password</label>
            <input type="password" @bind="reqDataUser.Password" id="passwordInput" class="form-control form-control-lg" disabled="@isSubmitting"/>
        </div>
        <div class="form-outline mb-4">
            <label class="form-label" for="nameInput">Name</label>
            <input type="text" @bind="reqDataUser.Name" id="nameInput" class="form-control form-control-lg" disabled="@isSubmitting"/>
        </div>
        <div class="form-outline mb-4">
            <label class="form-label" for="descInput">Description</label>
            <input type="text" @bind="reqDataUser.Description" id="descInput" class="form-control form-control-lg" disabled="@isSubmitting"/>
        </div>
        <div class="pt-1 mb-4">
            <button class="btn btn-info btn-lg btn-block" type="submit" disabled="@isSubmitting">
                @if (isSubmitting) { <span>Loading...</span> } else { <span>Add User</span> }
            </button>
        </div>
    </form>
</div>

@code {
    private List<UserDataShort>? users;
    private ReqDataUser reqDataUser = new();
    
    // State management
    private bool isLoading = true;
    private bool isSubmitting = false;
    private string? errorMessage;

    [Inject] private ApiRequestService ApiRequest { get; set; } = default!;

    protected override async Task OnInitializedAsync()
    {
        await GetAllUsersAsync();
    }

    private async Task GetAllUsersAsync()
    {
        isLoading = true;
        errorMessage = null;
        
        try 
        {
            var userData = await ApiRequest.GetAllUsersAsync();
            users = userData?.data?.users ?? new List<UserDataShort>();
        }
        catch (Exception ex)
        {
            errorMessage = $"Failed to load users: {ex.Message}";
            users = new List<UserDataShort>();
        }
        finally 
        {
            isLoading = false;
        }
    }

    private async Task HandleSubmit()
    {
        if (isSubmitting) return; // Prevent double clicks

        isSubmitting = true;
        errorMessage = null;

        try 
        {
            var result = await ApiRequest.AddNewUser(reqDataUser);

            if (result.status)
            {
                // Reset form
                reqDataUser = new ReqDataUser();
                // Refresh list
                await GetAllUsersAsync();
            }
            else
            {
                errorMessage = "Failed to add user. Please check your data.";
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Error: {ex.Message}";
        }
        finally 
        {
            isSubmitting = false;
        }
    }
}