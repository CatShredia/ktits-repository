{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug API",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "Build API",
      "program": "dotnet",
      "args": [
        "run",
        "--project",
        "TestApi3K/TestApi3K.csproj",
        "--launch-profile",
        "http"
      ],
      "cwd": "${workspaceFolder}",
      "stopAtEntry": false,
      "serverReadyAction": {
        "action": "openExternally",
        "pattern": "Now listening on:\\s+(https?://\\S+)"
      },
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development"
      },
      "console": "internalConsole"
    },
    {
      "name": "Debug Blazor WebAssembly",
      "type": "blazorwasm",
      "request": "launch",
      "hosted": false,
      "program": "${workspaceFolder}/TestBlazorAssembly/bin/Debug/net8.0/TestBlazorAssembly.dll",
      "cwd": "${workspaceFolder}/TestBlazorAssembly",
      "browser": "chrome",
      "url": "http://localhost:5156",
      "inspectUri": "{wsProtocol}://{url.hostname}:{url.port}/_framework/debug/ws-proxy?browser={browserInspectUri}",
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development"
      }
    },
    {
      "name": "Debug All (API + Blazor)",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "Start All (API + Blazor)",
      "program": "dotnet",
      "args": [
        "run",
        "--project",
        "TestApi3K/TestApi3K.csproj",
        "--launch-profile",
        "http"
      ],
      "cwd": "${workspaceFolder}",
      "stopAtEntry": false,
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development"
      },
      "console": "internalConsole"
    }
  ]
}
