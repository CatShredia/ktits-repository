{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Launch and Debug Standalone Blazor WebAssembly App",
      "type": "blazorwasm",
      "request": "launch",
      "cwd": "${workspaceFolder}/TestBlazorAssembly",
      "browser": "chrome"
    },
    {
      "name": "Launch with Hot Reload (watch)",
      "type": "blazorwasm",
      "request": "launch",
      "cwd": "${workspaceFolder}/TestBlazorAssembly",
      "preLaunchTask": "watch",
      "hotReloadEnabled": true,
      "browser": "chrome"
    }
  ]
}
