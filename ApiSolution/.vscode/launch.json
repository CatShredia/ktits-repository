{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug API",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "Start API",
      "program": "${workspaceFolder}/TestApi3K/bin/Debug/net8.0/TestApi3K.dll",
      "args": [],
      "cwd": "${workspaceFolder}/TestApi3K",
      "stopAtEntry": false,
      "serverReadyAction": {
        "action": "openExternally",
        "pattern": "Now listening on:\\s+(https?://\\S+)"
      },
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development"
      },
      "sourceFileMap": {
        "/Views": "${workspaceFolder}/Views"
      }
    },
    {
      "name": "Debug Blazor",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "Start Blazor",
      "program": "${workspaceFolder}/TestBlazorAssembly/bin/Debug/net8.0/TestBlazorAssembly.dll",
      "args": [],
      "cwd": "${workspaceFolder}/TestBlazorAssembly",
      "stopAtEntry": false,
      "serverReadyAction": {
        "action": "openExternally",
        "pattern": "Now listening on:\\s+(https?://\\S+)"
      },
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development"
      },
      "sourceFileMap": {
        "/Views": "${workspaceFolder}/Views"
      }
    }
  ]
}
