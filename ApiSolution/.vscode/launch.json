{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Blazor WebAssembly",
      "type": "blazorwasm",
      "request": "launch",
      "cwd": "${workspaceFolder}/TestBlazorAssembly",
      "browser": "chrome"
    },
    {
      "name": "Web API",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "run-api",
      "program": "${workspaceFolder}/TestApi3K/bin/Debug/net8.0/TestApi3K.dll",
      "args": [],
      "cwd": "${workspaceFolder}/TestApi3K",
      "stopAtEntry": false,
      "console": "internalConsole"
    },
    {
      "name": "Run All (API + Blazor)",
      "type": "blazorwasm",
      "request": "launch",
      "cwd": "${workspaceFolder}/TestBlazorAssembly",
      "browser": "chrome",
      "preLaunchTask": "run-all"
    },
    {
      "name": "Watch All (Hot Reload)",
      "type": "blazorwasm",
      "request": "launch",
      "cwd": "${workspaceFolder}/TestBlazorAssembly",
      "browser": "chrome",
      "preLaunchTask": "watch-all",
      "hotReloadEnabled": true
    }
  ],
  "compounds": [
    {
      "name": "API + Blazor",
      "configurations": ["Web API", "Blazor WebAssembly"],
      "presentation": {
        "hidden": false,
        "group": "1_compound",
        "order": 1
      }
    }
  ]
}
