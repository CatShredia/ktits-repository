{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build API",
      "type": "dotnet",
      "command": "build",
      "project": "TestApi3K/TestApi3K.csproj",
      "problemMatcher": "$msCompile",
      "group": {
        "kind": "build",
        "isDefault": false
      }
    },
    {
      "label": "Build Blazor",
      "type": "dotnet",
      "command": "build",
      "project": "TestBlazorAssembly/TestBlazorAssembly.csproj",
      "problemMatcher": "$msCompile",
      "group": {
        "kind": "build",
        "isDefault": false
      }
    },
    {
      "label": "Build All",
      "dependsOn": ["Build API", "Build Blazor"],
      "problemMatcher": []
    },
    {
      "label": "Run API",
      "type": "dotnet",
      "command": "run",
      "project": "TestApi3K/TestApi3K.csproj",
      "args": ["--launch-profile", "http"],
      "problemMatcher": "$msCompile",
      "isBackground": true
    },
    {
      "label": "Run Blazor",
      "type": "dotnet",
      "command": "run",
      "project": "TestBlazorAssembly/TestBlazorAssembly.csproj",
      "args": ["--launch-profile", "http"],
      "problemMatcher": "$msCompile",
      "isBackground": true
    },
    {
      "label": "Run All (API + Blazor)",
      "dependsOn": ["Run API", "Run Blazor"],
      "problemMatcher": []
    }
  ]
}
