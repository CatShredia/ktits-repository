{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build API",
      "type": "shell",
      "command": "dotnet build",
      "options": {
        "cwd": "${workspaceFolder}/TestApi3K"
      },
      "problemMatcher": "$msCompile",
      "group": {
        "kind": "build",
        "isDefault": false
      }
    },
    {
      "label": "Build Blazor",
      "type": "shell",
      "command": "dotnet build",
      "options": {
        "cwd": "${workspaceFolder}/TestBlazorAssembly"
      },
      "problemMatcher": "$msCompile",
      "group": {
        "kind": "build",
        "isDefault": false
      }
    },
    {
      "label": "Build All",
      "dependsOn": ["Build API", "Build Blazor"],
      "problemMatcher": []
    },
    {
      "label": "Run API",
      "type": "shell",
      "command": "dotnet run",
      "options": {
        "cwd": "${workspaceFolder}/TestApi3K"
      },
      "args": ["--launch-profile", "http"],
      "problemMatcher": "$msCompile",
      "isBackground": true
    },
    {
      "label": "Run Blazor",
      "type": "shell",
      "command": "dotnet run",
      "options": {
        "cwd": "${workspaceFolder}/TestBlazorAssembly"
      },
      "args": ["--launch-profile", "http"],
      "problemMatcher": "$msCompile",
      "isBackground": true
    }
  ]
}
