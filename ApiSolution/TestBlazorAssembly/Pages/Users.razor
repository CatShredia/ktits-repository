@page "/users"
@using TestBlazorAssembly.ApiRequest
@using TestBlazorAssembly.ApiRequest.Models

<PageTitle>User List</PageTitle>

<h1>User List</h1>

@if (isLoading)
{
    <p class="text-center">Loading data...</p>
}
else if (users == null || !users.Any())
{
    <p class="text-center text-muted">No users found.</p>
}
else
{
    <table class="table table-bordered">
        <thead class="alert-dark">
        <tr>
            <th>ID</th>
            <th>Name</th>
            <th>Description</th>
            <th>Actions</th>
        </tr>
        </thead>
        <tbody>
        @foreach (var user in users)
        {
            <tr>
                <td>@user.id_User</td>
                <td>@user.Name</td>
                <td>@user.Description</td>
                <td>
                    <button class="btn btn-sm btn-primary me-2" @onclick="() => OpenEditModal(user)">
                        <i class="bi bi-pencil"></i> Edit
                    </button>
                    <button class="btn btn-sm btn-danger" @onclick="() => DeleteUser(user.id_User)">
                        <i class="bi bi-trash"></i> Delete
                    </button>
                </td>
            </tr>
        }
        </tbody>
    </table>
}

<hr/>

<h1>Add New User</h1>

@if (!string.IsNullOrEmpty(errorMessage))
{
    <div class="alert alert-danger">@errorMessage</div>
}

<div class="d-flex align-items-center h-custom-2 px-5 ms-xl-4 mt-5 pt-5 pt-xl-0 mt-xl-n5">
    @* Use EditForm or standard form with onsubmit *@
    <form style="width: 23rem;" @onsubmit="HandleSubmit">
        <div class="form-outline mb-4">
            <label class="form-label" for="loginInput">Login</label>
            <input type="text" @bind="reqDataUser.Login" id="loginInput" class="form-control form-control-lg"
                   disabled="@isSubmitting"/>
        </div>
        <div class="form-outline mb-4">
            <label class="form-label" for="passwordInput">Password</label>
            <input type="password" @bind="reqDataUser.Password" id="passwordInput" class="form-control form-control-lg"
                   disabled="@isSubmitting"/>
        </div>
        <div class="form-outline mb-4">
            <label class="form-label" for="nameInput">Name</label>
            <input type="text" @bind="reqDataUser.Name" id="nameInput" class="form-control form-control-lg"
                   disabled="@isSubmitting"/>
        </div>
        <div class="form-outline mb-4">
            <label class="form-label" for="descInput">Description</label>
            <input type="text" @bind="reqDataUser.Description" id="descInput" class="form-control form-control-lg"
                   disabled="@isSubmitting"/>
        </div>
        <div class="pt-1 mb-4">
            <button class="btn btn-info btn-lg btn-block" type="submit" disabled="@isSubmitting">
                @if (isSubmitting)
                {
                    <span>Loading...</span>
                }
                else
                {
                    <span>Add User</span>
                }
            </button>
        </div>
    </form>
</div>

@if (showEditModal)
{
    <div class="modal fade show d-block" tabindex="-1" role="dialog">
        <div class="modal-dialog" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Edit User</h5>
                    <button type="button" class="btn-close" @onclick="CloseEditModal"></button>
                </div>
                <div class="modal-body">
                    @if (!string.IsNullOrEmpty(editErrorMessage))
                    {
                        <div class="alert alert-danger">@editErrorMessage</div>
                    }

                    <div class="form-outline mb-3">
                        <label class="form-label">Login</label>
                        <input type="text" @bind="editDataUser.Login" class="form-control" />
                    </div>
                    <div class="form-outline mb-3">
                        <label class="form-label">Password</label>
                        <input type="password" @bind="editDataUser.Password" class="form-control" />
                    </div>
                    <div class="form-outline mb-3">
                        <label class="form-label">Name</label>
                        <input type="text" @bind="editDataUser.Name" class="form-control" />
                    </div>
                    <div class="form-outline mb-3">
                        <label class="form-label">Description</label>
                        <input type="text" @bind="editDataUser.Description" class="form-control" />
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" @onclick="CloseEditModal">Cancel</button>
                    <button type="button" class="btn btn-primary" @onclick="SaveEdit">Save</button>
                </div>
            </div>
        </div>
    </div>
    <div class="modal-backdrop fade show"></div>
}

@code {
    private List<UserDataShort>? users;
    private ReqDataUser reqDataUser = new();
    private EditDataUser editDataUser = new();

    private bool isLoading = true;
    private bool isSubmitting = false;
    private string? errorMessage;
    private string? editErrorMessage;
    private bool showEditModal = false;

    [Inject] private ApiRequestService ApiRequest { get; set; } = default!;

    protected override async Task OnInitializedAsync()
    {
        await GetAllUsersAsync();
    }

    private async Task GetAllUsersAsync()
    {
        Console.WriteLine("rveevrevr");

        isLoading = true;
        errorMessage = null;

        try
        {
            var userData = await ApiRequest.GetAllUsersAsync();
            users = userData?.data?.users ?? new List<UserDataShort>();
            Console.WriteLine(users[0]);
        }
        catch (Exception ex)
        {
            errorMessage = $"Failed to load users: {ex.Message}";
            users = new List<UserDataShort>();
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task HandleSubmit()
    {
        if (isSubmitting) return;

        isSubmitting = true;
        errorMessage = null;

        try
        {
            var result = await ApiRequest.AddNewUser(reqDataUser);

            if (result.status)
            {
                reqDataUser = new ReqDataUser();
                await GetAllUsersAsync();
            }
            else
            {
                errorMessage = "Failed to add user. Please check your data.";
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Error: {ex.Message}";
        }
        finally
        {
            isSubmitting = false;
        }
    }

    private void OpenEditModal(UserDataShort user)
    {
        editDataUser = new EditDataUser
        {
            id_User = user.id_User,
            Name = user.Name,
            Description = user.Description,
            Login = user.Name,
            Password = "",
            id_Role = user.id_Role
        };
        editErrorMessage = null;
        showEditModal = true;
    }

    private void CloseEditModal()
    {
        showEditModal = false;
        editDataUser = new EditDataUser();
        editErrorMessage = null;
    }

    private async Task SaveEdit()
    {
        isSubmitting = true;
        editErrorMessage = null;

        try
        {
            var result = await ApiRequest.UpdateUser(editDataUser);

            if (result.success)
            {
                CloseEditModal();
                await GetAllUsersAsync();
            }
            else
            {
                editErrorMessage = result.message ?? "Failed to update user.";
            }
        }
        catch (Exception ex)
        {
            editErrorMessage = $"Error: {ex.Message}";
        }
        finally
        {
            isSubmitting = false;
        }
    }

    private async Task DeleteUser(int userId)
    {
        var confirmed = await Confirm("Are you sure you want to delete this user?");
        if (!confirmed)
            return;

        try
        {
            var result = await ApiRequest.DeleteUser(userId);

            if (result.success)
            {
                await GetAllUsersAsync();
            }
            else
            {
                errorMessage = result.message ?? "Failed to delete user.";
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Error: {ex.Message}";
        }
    }

    private async Task<bool> Confirm(string message)
    {
        return await JSRuntime.InvokeAsync<bool>("confirm", message);
    }

    [Inject] private Microsoft.JSInterop.IJSRuntime JSRuntime { get; set; } = default!;
}
