<Window
    x:Class="RecipeApp.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:RecipeApp"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="Recipe App"
    WindowStartupLocation="CenterScreen"
    WindowState="Maximized"
    mc:Ignorable="d">
    <Window.Resources>
    <!-- Стиль для TextBlock -->
    <Style TargetType="TextBlock">
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Foreground" Value="#333333"/>
        <Setter Property="Margin" Value="0,5"/>
    </Style>
    <!-- Стиль для TextBox -->
    <Style TargetType="TextBox">
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Padding" Value="5"/>
        <Setter Property="Margin" Value="0,5"/>
        <Setter Property="BorderBrush" Value="#cccccc"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Background" Value="White"/>
        <Setter Property="MinHeight" Value="30"/>
        <Setter Property="MinWidth" Value="200"/>
        <Style.Triggers>
            <Trigger Property="IsFocused" Value="True">
                <Setter Property="BorderBrush" Value="#007ACC"/>
            </Trigger>
        </Style.Triggers>
    </Style>
    <!-- Стиль для Button -->
    <Style TargetType="Button">
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Padding" Value="10,5"/>
        <Setter Property="Margin" Value="0,5"/>
        <Setter Property="Background" Value="#007ACC"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="BorderBrush" Value="#007ACC"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="MinWidth" Value="100"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="#005999"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="#003F66"/>
            </Trigger>
        </Style.Triggers>
    </Style>
    <!-- Стиль для ComboBox -->
    <Style TargetType="ComboBox">
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Padding" Value="5"/>
        <Setter Property="Margin" Value="0,5"/>
        <Setter Property="BorderBrush" Value="#cccccc"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Background" Value="White"/>
        <Setter Property="MinHeight" Value="30"/>
        <Setter Property="MinWidth" Value="200"/>
        <Style.Triggers>
            <Trigger Property="IsFocused" Value="True">
                <Setter Property="BorderBrush" Value="#007ACC"/>
            </Trigger>
        </Style.Triggers>
    </Style>
    <!-- Стиль для ScrollViewer -->
    <Style TargetType="ScrollViewer">
        <Setter Property="Margin" Value="5"/>
        <Setter Property="Padding" Value="5"/>
    </Style>
</Window.Resources>
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <!--  1. Секция поиска и сортировки  -->
        <StackPanel
            Grid.Row="0"
            Margin="0,0,0,10"
            Orientation="Horizontal">
            <TextBlock
                Margin="0,0,5,0"
                VerticalAlignment="Center"
                Text="Поиск:" />
            <TextBox
                x:Name="SearchTextBox"
                Width="200"
                Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
            <TextBlock
                Margin="10,0,5,0"
                VerticalAlignment="Center"
                Text="Фильтр по ингредиентам:" />
            <TextBox
                x:Name="IngredientFilterTextBox"
                Width="200"
                Text="{Binding IngredientFilter, UpdateSourceTrigger=PropertyChanged}" />
            <TextBlock
                Margin="10,0,5,0"
                VerticalAlignment="Center"
                Text="Сортировка:" />
            <ComboBox
                x:Name="SortComboBox"
                Width="200"
                ItemsSource="{Binding SortOptions}"
                SelectedItem="{Binding SelectedSortOption}" />
        </StackPanel>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <!--  2. Секция просмотра рецепта  -->
            <ScrollViewer
                Grid.Column="0"
                Margin="5"
                VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock
                        Margin="0,0,0,10"
                        FontSize="16"
                        FontWeight="Bold"
                        Text="Просмотр рецепта" />
                    <TextBlock FontWeight="Bold" Text="Название:" />
                    <TextBlock
                        Margin="0,0,0,5"
                        Text="{Binding SelectedRecipe.Name}"
                        TextWrapping="NoWrap" />
                    <TextBlock FontWeight="Bold" Text="Ингредиенты:" />
                    <ItemsControl Margin="0,0,0,5" ItemsSource="{Binding SelectedRecipe.IngredientsList}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Margin="0,0,0,2" Text="{Binding}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock FontWeight="Bold" Text="Описание:" />
                    <TextBlock
                        Margin="0,0,0,5"
                        Text="{Binding SelectedRecipe.Description}"
                        TextWrapping="Wrap" />
                    <TextBlock FontWeight="Bold" Text="Улучшения:" />
                    <TextBlock
                        Margin="0,0,0,10"
                        Text="{Binding SelectedRecipe.Improvements}"
                        TextWrapping="Wrap" />
                    <TextBlock FontWeight="Bold" Text="Изображение:" />
                    <Image Source="{Binding SelectedRecipe.ImagePath}" Height="200" Margin="0,10,0,10" />
                    <Button
                        Width="100"
                        HorizontalAlignment="Left"
                        Command="{Binding EditRecipeCommand}"
                        Content="Изменить" />
                </StackPanel>
            </ScrollViewer>
            <!--  3. Секция создания/редактирования рецепта  -->
            <StackPanel Grid.Column="1" Margin="5">
                <TextBlock
                    Margin="0,0,0,10"
                    FontSize="16"
                    FontWeight="Bold"
                    Text="Редактировать рецепт" />
                <TextBlock FontWeight="Bold" Text="Название:" />
                <TextBox Margin="0,0,0,5" Text="{Binding RecipeName, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock FontWeight="Bold" Text="Ингредиенты (разделяйте запятыми):" />
                <TextBox Margin="0,0,0,5" Text="{Binding RecipeIngredients, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock FontWeight="Bold" Text="Описание:" />
                <TextBox
                    Height="80"
                    Margin="0,0,0,5"
                    Text="{Binding RecipeDescription, UpdateSourceTrigger=PropertyChanged}"
                    TextWrapping="Wrap" />
                <TextBlock FontWeight="Bold" Text="Улучшения:" />
                <TextBox
                    Height="50"
                    Margin="0,0,0,10"
                    Text="{Binding RecipeImprovements, UpdateSourceTrigger=PropertyChanged}"
                    TextWrapping="Wrap" />
                <TextBlock FontWeight="Bold" Text="Изображение:" />
                <TextBox Margin="0,0,0,5" Text="{Binding RecipeImagePath}" IsReadOnly="True" />
                <Button
                    Width="100"
                    HorizontalAlignment="Left"
                    Click="LoadImage_Click"
                    Content="Загрузить изображение" />
                <Button
                    Width="100"
                    HorizontalAlignment="Left"
                    Command="{Binding SaveRecipeCommand}"
                    Content="Сохранить" />
            </StackPanel>
        </Grid>
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition />
            </Grid.ColumnDefinitions>
            <!--  Отображение списка рецептов  -->
            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
                <ListBox
                    Margin="0,10,0,0"
                    DisplayMemberPath="Name"
                    ItemsSource="{Binding FilteredRecipes}"
                    SelectedItem="{Binding SelectedRecipe}" />
            </ScrollViewer>
            <ScrollViewer
                Grid.Column="1"
                Margin="10"
                VerticalAlignment="Stretch">
                <StackPanel x:Name="recipeListPanel">
                    <Button
                        Grid.Column="0"
                        Margin="5,0"
                        Click="Button_Click"
                        Content="Случайный" />
                    <WebBrowser
                        x:Name="testWebBrowser"
                        MinHeight="500"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch" />
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>
  