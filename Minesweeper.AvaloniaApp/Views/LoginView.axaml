<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Minesweeper.AvaloniaApp.Views.LoginView">
    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10" Width="250">
        <TextBlock Text="Minesweeper" FontSize="24" HorizontalAlignment="Center"/>
        <TextBox Watermark="Login" Text="{Binding Login}"/>
        <TextBox Watermark="Password" PasswordChar="•" Text="{Binding Password}"/>
        <Button Content="Login / Register" Command="{Binding SubmitCommand}" HorizontalAlignment="Stretch"/>
        <TextBlock Text="{Binding Message}" Foreground="Red"/>
    </StackPanel>
</UserControl>