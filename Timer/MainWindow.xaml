<Window
    x:Class="PomodoroTimer.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Помидоро Таймер"
    Width="320"
    Height="450">
    <Grid Margin="10">
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
            <TextBlock
                x:Name="StageText"
                Margin="0,10"
                FontSize="18"
                Text="Ожидание..."
                TextAlignment="Center" />
            <TextBlock
                x:Name="TimerText"
                FontSize="36"
                Text="25:00"
                TextAlignment="Center" />

            <!--  Блок настройки работы  -->
            <GroupBox Margin="0,10" Header="Работа">
                <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
                    <TextBlock Margin="5" Text="Мин:" />
                    <TextBox
                        x:Name="WorkMinutesBox"
                        Width="40"
                        Text="25" />
                    <TextBlock Margin="10,0,5,0" Text="Сек:" />
                    <TextBox
                        x:Name="WorkSecondsBox"
                        Width="40"
                        Text="0" />
                </StackPanel>
            </GroupBox>

            <!--  Блок настройки отдыха  -->
            <GroupBox Header="Отдых">
                <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
                    <TextBlock Margin="5" Text="Мин:" />
                    <TextBox
                        x:Name="BreakMinutesBox"
                        Width="40"
                        Text="5" />
                    <TextBlock Margin="10,0,5,0" Text="Сек:" />
                    <TextBox
                        x:Name="BreakSecondsBox"
                        Width="40"
                        Text="0" />
                </StackPanel>
            </GroupBox>

            <StackPanel
                Margin="0,10"
                HorizontalAlignment="Center"
                Orientation="Horizontal">
                <Button
                    Width="100"
                    Margin="5"
                    Click="StartButton_Click"
                    Content="Старт" />
                <Button
                    Width="100"
                    Margin="5"
                    Click="ResetButton_Click"
                    Content="Сброс" />
            </StackPanel>

            <TextBlock
                x:Name="SessionCountText"
                Margin="0,10"
                FontSize="14"
                Text="Завершено сессий: 0" />
        </StackPanel>
    </Grid>
</Window>
