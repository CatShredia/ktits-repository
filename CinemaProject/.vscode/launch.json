{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "🚀 Debug CinemaAPI",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "Build CinemaAPI",
      "program": "${workspaceFolder}/CinemaAPI/bin/Debug/net8.0/CinemaAPI.dll",
      "args": [],
      "cwd": "${workspaceFolder}/CinemaAPI",
      "stopAtEntry": false,
      "serverReadyAction": {
        "action": "openExternally",
        "pattern": "Now listening on:\\s+(https?://\\S+)"
      },
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development"
      },
      "console": "internalConsole"
    },
    {
      "name": "🎨 Debug CinemaBlazor",
      "type": "blazorwasm",
      "request": "launch",
      "preLaunchTask": "Build CinemaBlazor",
      "hosted": true,
      "cwd": "${workspaceFolder}/CinemaBlazor",
      "browser": "chrome",
      "url": "http://localhost:5156",
      "inspectUri": "{wsProtocol}://{url.hostname}:{url.port}/_framework/debug/ws-proxy?browser={browserInspectUri}",
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development"
      }
    },
    {
      "name": "⚡ Debug All (API + Blazor)",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "Build All",
      "program": "${workspaceFolder}/CinemaAPI/bin/Debug/net8.0/CinemaAPI.dll",
      "args": [],
      "cwd": "${workspaceFolder}/CinemaAPI",
      "stopAtEntry": false,
      "serverReadyAction": {
        "action": "openExternally",
        "pattern": "Now listening on:\\s+(https?://\\S+)"
      },
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development"
      },
      "console": "internalConsole",
      "justMyCode": false
    }
  ],
  "compounds": [
    {
      "name": "🔥 Run All with Debug (API + Blazor)",
      "configurations": [
        "⚡ Debug All (API + Blazor)",
        "🎨 Debug CinemaBlazor"
      ],
      "presentation": {
        "hidden": false,
        "group": "1_run-all",
        "order": 1
      },
      "stopAll": false
    }
  ]
}
