{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "🚀 Debug CinemaAPI",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "Build CinemaAPI",
      "program": "${workspaceFolder}/CinemaAPI/bin/Debug/net8.0/CinemaAPI.dll",
      "args": [],
      "cwd": "${workspaceFolder}/CinemaAPI",
      "stopAtEntry": false,
      "serverReadyAction": {
        "action": "openExternally",
        "pattern": "Now listening on:\\s+(https?://\\S+)"
      },
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development"
      },
      "console": "internalConsole"
    },
    {
      "name": "🎨 Debug CinemaBlazor",
      "type": "blazorwasm",
      "request": "launch",
      "preLaunchTask": "Run CinemaBlazor",
      "url": "https://localhost:7156",
      "browser": "chrome"
    },
    {
      "name": "⚡ Debug All (API + Blazor)",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "Run All (API + Blazor)",
      "program": "${workspaceFolder}/CinemaAPI/bin/Debug/net8.0/CinemaAPI.dll",
      "args": [],
      "cwd": "${workspaceFolder}/CinemaAPI",
      "stopAtEntry": false,
      "serverReadyAction": {
        "action": "openExternally",
        "pattern": "Now listening on:\\s+(https?://\\S+)"
      },
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development"
      },
      "console": "internalConsole",
      "justMyCode": false
    }
  ],
  "compounds": [
    {
      "name": "🔥 Run All with Debug (API + Blazor)",
      "configurations": [
        "⚡ Debug All (API + Blazor)",
        "🎨 Debug CinemaBlazor"
      ],
      "presentation": {
        "hidden": false,
        "group": "1_run-all",
        "order": 1
      },
      "stopAll": false
    }
  ]
}
