@page "/films/{id:int}/edit"
@layout MainLayout
@inject IFilmService FilmService
@inject IGenreService GenreService
@inject NavigationManager Navigation
@inject IAuthService AuthService
@inject IJSRuntime JSRuntime

<PageTitle>Изменить фильм - CinemaBlazor</PageTitle>

<AuthorizeView Roles="admin">
    <Authorized>
        @if (isLoading)
        {
            <div class="text-center py-5">
                <div class="spinner-border text-primary" role="status">
                    <span class="visually-hidden">Загрузка...</span>
                </div>
            </div>
        }
        else if (film == null)
        {
            <div class="alert alert-danger">Фильм не найден.</div>
        }
        else
        {
            <h3>✏️ Изменить фильм</h3>

            <div class="card">
                <div class="card-body">
                    <EditForm Model="@film" OnValidSubmit="HandleUpdate" Context="EditContext">
                        <DataAnnotationsValidator />

                        <div class="mb-3">
                            <label class="form-label">Название фильма *</label>
                            <InputText @bind-Value="film.Name" class="form-control" />
                            <ValidationMessage For="@(() => film.Name)" />
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Описание</label>
                            <InputTextArea @bind-Value="film.Description" class="form-control" rows="4" />
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Дата выхода *</label>
                            <InputDate @bind-Value="film.ReleaseDate" class="form-control" />
                            <ValidationMessage For="@(() => film.ReleaseDate)" />
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Жанр *</label>
                            <InputSelect @bind-Value="film.GenreId" class="form-select">
                                @foreach (var genre in genres)
                                {
                                    <option value="@genre.Id">@genre.Name</option>
                                }
                            </InputSelect>
                            <ValidationMessage For="@(() => film.GenreId)" />
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Изображение фильма</label>

                            <!-- Текущее изображение -->
                            @if (!string.IsNullOrEmpty(currentImageUrl) && !removeImage)
                            {
                                <div class="mb-3">
                                    <label class="form-label">Текущее изображение:</label><br />
                                    <img src="@currentImageUrl" class="img-thumbnail"
                                         style="max-height: 200px; max-width: 100%;" alt="Current" />
                                </div>
                            }

                            <!-- Переключатель режима -->
                            <div class="btn-group w-100 mb-2" role="group">
                                <input type="radio" class="btn-check" name="imageMode" id="modeKeep"
                                       value="keep" checked="@(imageMode == "keep")" @onclick="@(() => imageMode = "keep")" />
                                <label class="btn btn-outline-secondary" for="modeKeep">
                                    ✓ Оставить текущее
                                </label>

                                <input type="radio" class="btn-check" name="imageMode" id="modeFile"
                                       value="file" checked="@(imageMode == "file")" @onclick="@(() => imageMode = "file")" />
                                <label class="btn btn-outline-primary" for="modeFile">
                                    📤 Загрузить новый
                                </label>

                                <input type="radio" class="btn-check" name="imageMode" id="modeUrl"
                                       value="url" checked="@(imageMode == "url")" @onclick="@(() => imageMode = "url")" />
                                <label class="btn btn-outline-primary" for="modeUrl">
                                    🔗 Внешняя ссылка
                                </label>

                                <input type="radio" class="btn-check" name="imageMode" id="modeRemove"
                                       value="remove" checked="@(imageMode == "remove")" @onclick="@(() => imageMode = "remove")" />
                                <label class="btn btn-outline-danger" for="modeRemove">
                                    🗑️ Удалить
                                </label>
                            </div>

                            @if (imageMode == "file")
                            {
                                <!-- Загрузка файла -->
                                <InputFile OnChange="HandleFileSelected" class="form-control"
                                           accept="image/png, image/jpeg, image/jpg, image/webp" />
                                <div class="form-text">
                                    Допустимые форматы: JPG, PNG, WebP. Макс. размер: 5 MB
                                </div>
                            }
                            else if (imageMode == "url")
                            {
                                <!-- Внешний URL -->
                                <InputText @bind-Value="externalImageUrl" class="form-control"
                                           placeholder="https://example.com/image.jpg" />
                            }
                            else if (imageMode == "remove")
                            {
                                <div class="alert alert-warning">
                                    Изображение будет удалено при сохранении
                                </div>
                            }

                            <!-- Предпросмотр нового изображения -->
                            @if (!string.IsNullOrEmpty(imagePreview) && imageMode == "file")
                            {
                                <div class="mt-3">
                                    <label class="form-label">Предпросмотр:</label><br />
                                    <img src="@imagePreview" class="img-thumbnail" style="max-height: 200px; max-width: 100%;"
                                         alt="Preview" />
                                </div>
                            }
                            else if (!string.IsNullOrEmpty(externalImageUrl) && imageMode == "url")
                            {
                                <div class="mt-3">
                                    <label class="form-label">Предпросмотр:</label><br />
                                    <img src="@externalImageUrl" class="img-thumbnail"
                                         style="max-height: 200px; max-width: 100%;" alt="Preview" />
                                </div>
                            }
                        </div>

                        @if (!string.IsNullOrEmpty(errorMessage))
                        {
                            <div class="alert alert-danger">@errorMessage</div>
                        }

                        <button type="submit" class="btn btn-primary" disabled="@isLoading">
                            @if (isLoading)
                            {
                                <span class="spinner-border spinner-border-sm me-2"></span>
                            }
                            Сохранить изменения
                        </button>
                        <a href="films/@Id" class="btn btn-outline-secondary ms-2">Отмена</a>
                    </EditForm>
                </div>
            </div>
        }
    </Authorized>
    <NotAuthorized>
        <div class="alert alert-warning">Вы должны быть администратором для редактирования фильмов.</div>
    </NotAuthorized>
</AuthorizeView>

@code {
    [Parameter]
    public int Id { get; set; }

    private Film? film;
    private List<Genre> genres = new();
    private string? errorMessage;
    private bool isLoading = true;
    private bool _isAdmin = false;

    // Переменные для работы с изображениями
    private string imageMode = "keep"; // "keep", "file", "url", "remove"
    private IBrowserFile? selectedFile;
    private string? externalImageUrl;
    private string? imagePreview;
    private string? currentImageUrl;
    private bool removeImage = false;

    protected override async Task OnInitializedAsync()
    {
        _isAdmin = await AuthService.IsInRoleAsync("admin");

        if (!_isAdmin)
        {
            isLoading = false;
            return;
        }

        genres = await GenreService.GetAllGenresAsync();
        film = await FilmService.GetFilmByIdAsync(Id);

        if (film != null)
        {
            currentImageUrl = film.ImageUrl;
        }

        isLoading = false;
    }

    private async Task HandleFileSelected(InputFileChangeEventArgs e)
    {
        var file = e.File;

        // Проверка типа файла
        if (!file.ContentType.StartsWith("image/"))
        {
            errorMessage = "Пожалуйста, выберите файл изображения (JPG, PNG, WebP)";
            return;
        }

        // Проверка размера (5 MB)
        if (file.Size > 5 * 1024 * 1024)
        {
            errorMessage = "Размер файла не должен превышать 5 MB";
            return;
        }

        selectedFile = file;
        errorMessage = null;

        // Создаём предпросмотр
        using var stream = file.OpenReadStream(maxAllowedSize: 5 * 1024 * 1024);
        using var memoryStream = new MemoryStream();
        await stream.CopyToAsync(memoryStream);
        var bytes = memoryStream.ToArray();
        imagePreview = $"data:{file.ContentType};base64,{Convert.ToBase64String(bytes)}";
    }

    private async Task HandleUpdate()
    {
        if (film == null)
        {
            errorMessage = "Фильм не найден";
            return;
        }

        // Проверка: если режим URL, проверяем что URL введён
        if (imageMode == "url" && string.IsNullOrEmpty(externalImageUrl))
        {
            errorMessage = "Введите URL изображения или выберите другой режим";
            return;
        }

        isLoading = true;
        errorMessage = null;

        // Определяем флаг удаления
        removeImage = imageMode == "remove";

        // Определяем внешний URL
        var urlToSend = imageMode == "url" ? externalImageUrl : null;

        try
        {
            var success = await FilmService.UpdateFilmAsync(Id, film, selectedFile, urlToSend, removeImage);

            if (success)
            {
                Navigation.NavigateTo($"/films/{Id}");
            }
            else
            {
                errorMessage = "Не удалось обновить фильм. Попробуйте снова.";
                isLoading = false;
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Ошибка: {ex.Message}";
            isLoading = false;
        }
    }
}