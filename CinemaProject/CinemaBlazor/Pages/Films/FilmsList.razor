@page "/films"
@layout MainLayout
@inject IFilmService FilmService
@inject IGenreService GenreService
@inject IAuthService AuthService
@inject IApiUrlService ApiUrlService

<PageTitle>Фильмы - CinemaBlazor</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-4">
    <h3 class="mb-0">Фильмы</h3>
    @if (_isAdmin)
    {
        <a href="films/create" class="btn btn-primary">
            <span class="bi bi-plus-circle"></span> Добавить фильм
        </a>
    }
</div>

<div class="card mb-3">
    <div class="card-body">
        <div class="row g-3">
            <div class="col-md-4">
                <input type="text" class="form-control" placeholder="Поиск по названию..." @bind="search"
                       @bind:event="oninput" />
            </div>
            <div class="col-md-3">
                <select class="form-select" @bind="selectedGenreId">
                    <option value="0">Все жанры</option>
                    @foreach (var genre in genres)
                    {
                        <option value="@genre.Id">@genre.Name</option>
                    }
                </select>
            </div>
            <div class="col-md-3">
                <select class="form-select" @bind="sortBy">
                    <option value="">Сортировать</option>
                    <option value="name">Название (А-Я)</option>
                    <option value="name_desc">Название (Я-А)</option>
                    <option value="releaseDate">Дата выхода (старые)</option>
                    <option value="releaseDate_desc">Дата выхода (новые)</option>
                    <option value="rating">Рейтинг (низкий-высокий)</option>
                    <option value="rating_desc">Рейтинг (высокий-низкий)</option>
                </select>
            </div>
            <div class="col-md-2">
                <button class="btn btn-primary w-100" @onclick="LoadFilms">
                    <span class="bi bi-search"></span> Фильтр
                </button>
            </div>
        </div>
    </div>
</div>

@if (isLoading)
{
    <div class="text-center py-5">
        <div class="spinner-border text-primary" role="status">
            <span class="visually-hidden">Загрузка...</span>
        </div>
    </div>
}
else if (films.Count == 0)
{
    <div class="alert alert-info">Фильмы не найдены.</div>
}
else
{
    <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
        @foreach (var film in films)
        {
            <div class="col">
                <div class="card h-100 shadow-sm">
                    @if (!string.IsNullOrEmpty(film.ImageUrl))
                    {
                        <img src="@ApiUrlService.GetImageUrl(film.ImageUrl)" class="card-img-top"
                             style="height: 200px; object-fit: cover;" alt="@film.Name" />
                    }
                    else
                    {
                        <div class="bg-secondary text-white d-flex align-items-center justify-content-center card-img-top"
                             style="height: 200px;">
                            <span class="bi bi-film" style="font-size: 3rem;"></span>
                        </div>
                    }
                    <div class="card-body">
                        <h5 class="card-title">@film.Name</h5>
                        <p class="card-text text-muted small">
                            @if (film.Genre != null)
                            {
                                <span class="badge bg-secondary me-1">@film.Genre.Name</span>
                            }
                            <span class="text-muted">@film.ReleaseDate.ToString("dd MMM yyyy")</span>
                        </p>
                        <p class="card-text">
                            @{
                                var desc = film.Description ?? "";
                                var preview = desc.Length > 100 ? desc.Substring(0, 100) + "..." : desc;
                            }
                            @preview
                        </p>
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <span class="badge bg-warning text-dark me-1">
                                    ⭐ @film.AverageRating.ToString("F1")
                                </span>
                                @if (film.CommentsCount > 0)
                                {
                                    <span class="badge bg-info text-dark">
                                        💬 @film.CommentsCount
                                    </span>
                                }
                            </div>
                            <a href="films/@film.Id" class="btn btn-sm btn-outline-primary">Подробнее</a>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}

@code {
    private List<Film> films = new();
    private List<Genre> genres = new();
    private string? sortBy;
    private int selectedGenreId;
    private string? search;
    private bool isLoading;
    private bool _isAdmin = false;

    protected override async Task OnInitializedAsync()
    {
        _isAdmin = await AuthService.IsInRoleAsync("admin");
        genres = await GenreService.GetAllGenresAsync();
        await LoadFilms();
    }

    private async Task LoadFilms()
    {
        isLoading = true;
        int? genreId = selectedGenreId > 0 ? selectedGenreId : null;
        films = await FilmService.GetAllFilmsAsync(sortBy, genreId, search);
        isLoading = false;
    }
}