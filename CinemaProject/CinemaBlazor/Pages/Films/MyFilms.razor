@page "/my-films"
@layout MainLayout
@inject IFilmService FilmService
@inject IAuthService AuthService
@inject IApiUrlService ApiUrlService

<PageTitle>Мои фильмы - CinemaBlazor</PageTitle>

<AuthorizeView Roles="admin">
    <Authorized>
        <h3>🎬 Мои фильмы</h3>

        @if (isLoading)
        {
            <div class="text-center py-5">
                <div class="spinner-border text-primary" role="status">
                    <span class="visually-hidden">Загрузка...</span>
                </div>
            </div>
        }
        else if (films.Count == 0)
        {
            <div class="alert alert-info">
                Вы ещё не создали ни одного фильма.
                <a href="films/create">Создать свой первый фильм!</a>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover">
                    <thead class="table-dark">
                        <tr>
                            <th>Постер</th>
                            <th>Название</th>
                            <th>Жанр</th>
                            <th>Дата выхода</th>
                            <th>Рейтинг</th>
                            <th>Действия</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var film in films)
                        {
                            <tr>
                                <td>
                                    @if (!string.IsNullOrEmpty(film.ImageUrl))
                                    {
                                        <img src="@ApiUrlService.GetImageUrl(film.ImageUrl)" alt="@film.Name" style="width: 50px; height: 75px; object-fit: cover;" class="rounded" />
                                    }
                                    else
                                    {
                                        <div class="bg-secondary text-white d-flex align-items-center justify-content-center rounded" style="width: 50px; height: 75px;">
                                            <span class="bi bi-film"></span>
                                        </div>
                                    }
                                </td>
                                <td>@film.Name</td>
                                <td>@(film.Genre?.Name ?? "Н/Д")</td>
                                <td>@film.ReleaseDate.ToString("dd MMM yyyy")</td>
                                <td>
                                    <span class="badge bg-warning text-dark">⭐ @film.AverageRating.ToString("F1")</span>
                                </td>
                                <td>
                                    <a href="films/@film.Id" class="btn btn-sm btn-outline-primary me-1">Просмотр</a>
                                    <a href="films/@film.Id/edit" class="btn btn-sm btn-outline-secondary">Изменить</a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </Authorized>
    <NotAuthorized>
        <div class="alert alert-warning">Вы должны быть администратором для просмотра этой страницы.</div>
    </NotAuthorized>
</AuthorizeView>

@code {
    private List<Film> films = new();
    private bool isLoading;
    private bool _isAdmin = false;

    protected override async Task OnInitializedAsync()
    {
        _isAdmin = await AuthService.IsInRoleAsync("admin");

        if (_isAdmin)
        {
            isLoading = true;
            films = await FilmService.GetMyFilmsAsync();
            isLoading = false;
        }
    }
}
