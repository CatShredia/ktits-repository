@page "/films/{id:int}"
@layout MainLayout
@inject IFilmService FilmService
@inject IRatingService RatingService
@inject IAuthService AuthService
@inject ICommentService CommentService
@inject NavigationManager Navigation
@inject IJSRuntime JSRuntime
@inject IApiUrlService ApiUrlService

<PageTitle>Информация о фильме - CinemaBlazor</PageTitle>

@if (isLoading)
{
    <div class="text-center py-5">
        <div class="spinner-border text-primary" role="status">
            <span class="visually-hidden">Загрузка...</span>
        </div>
    </div>
}
else if (film == null)
{
    <div class="alert alert-danger">Фильм не найден.</div>
}
else
{
    <div class="row">
        <div class="col-md-4">
            @if (!string.IsNullOrEmpty(film.ImageUrl))
            {
                <img src="@ApiUrlService.GetImageUrl(film.ImageUrl)" class="rounded shadow"
                     style="width: 100%; max-height: 400px; object-fit: cover;" alt="@film.Name" />
            }
            else
            {
                <div class="bg-secondary text-white d-flex align-items-center justify-content-center rounded shadow"
                     style="height: 300px;">
                    <span class="bi bi-film" style="font-size: 3rem;"></span>
                </div>
            }
        </div>
        <div class="col-md-8">
            <h2>@film.Name</h2>
            @if (film.Genre != null)
            {
                <span class="badge bg-primary">@film.Genre.Name</span>
            }
            <span class="badge bg-secondary ms-2">@film.ReleaseDate.ToString("dd MMMM yyyy")</span>

            @if (film.Author != null)
            {
                <p class="text-muted mt-2">
                    <small>Создал: @film.Author.Name @film.Author.Surname</small>
                </p>
            }

            <div class="mt-3">
                <h4>Рейтинг:
                    <span class="text-warning">⭐ @film.AverageRating.ToString("F1")/10</span>
                    <span class="text-muted">(@film.Ratings?.Count() оценок)</span>
                </h4>
            </div>

            <hr />

            <h5>Описание</h5>
            <p>@(film.Description ?? "Описание отсутствует.")</p>

            @if (_isAuthenticated)
            {
                <hr />
                <h5>Ваша оценка</h5>
                @if (userRating != null)
                {
                    <p>Вы оценили этот фильм на: <strong>@userRating.Value/10</strong></p>
                }
                else if (!hasRated)
                {
                    <div class="mb-3">
                        <label class="form-label">Оцените фильм (1-10):</label>
                        <input type="number" class="form-control" min="1" max="10" @bind="ratingValue" />
                    </div>
                    @if (!string.IsNullOrEmpty(ratingError))
                    {
                        <div class="alert alert-danger">@ratingError</div>
                    }
                    <button class="btn btn-warning" @onclick="SubmitRating" disabled="@isSubmittingRating">
                        @if (isSubmittingRating)
                        {
                            <span class="spinner-border spinner-border-sm me-2"></span>
                        }
                        Отправить оценку
                    </button>
                }
            }
            else
            {
                <p class="text-muted"><a href="login">Войдите</a>, чтобы оценить этот фильм.</p>
            }

            <hr />

            <h5>Комментарии</h5>
            @if (isLoadingComments)
            {
                <div class="text-center py-3">
                    <div class="spinner-border spinner-border-sm text-primary" role="status"></div>
                </div>
            }
            else
            {
                @if (comments.Count == 0)
                {
                    <p class="text-muted">Комментариев пока нет. Будьте первым!</p>
                }
                else
                {
                    <div class="mb-3" style="max-height: 400px; overflow-y: auto;">
                        @foreach (var comment in comments)
                        {
                            <div class="card mb-2">
                                <div class="card-body py-2">
                                    <div class="d-flex justify-content-between">
                                        <strong>@comment.Sender.Name @comment.Sender.Surname</strong>
                                        <small class="text-muted">@comment.CreatedAt.ToString("dd.MM.yyyy HH:mm")</small>
                                    </div>
                                    <p class="mb-0 mt-1">@comment.Content</p>
                                </div>
                            </div>
                        }
                    </div>
                }

                @if (_isAuthenticated)
                {
                    <div class="input-group">
                        <input type="text" class="form-control" placeholder="Написать комментарий..." @bind="newComment"
                               @bind:event="oninput" @onkeypress="HandleCommentKeyPress" />
                        <button class="btn btn-primary" @onclick="SubmitComment" disabled="@isSubmittingComment">
                            @if (isSubmittingComment)
                            {
                                <span class="spinner-border spinner-border-sm me-1"></span>
                            }
                            Отправить
                        </button>
                    </div>
                    @if (!string.IsNullOrEmpty(commentError))
                    {
                        <div class="alert alert-danger mt-2 mb-0">@commentError</div>
                    }
                }
                else
                {
                    <p class="text-muted mt-2"><a href="login">Войдите</a>, чтобы оставить комментарий.</p>
                }
            }

            <hr />

            @if (_isAdmin)
            {
                <a href="films/@film.Id/edit" class="btn btn-primary">Изменить фильм</a>
                <button class="btn btn-danger ms-2" @onclick="DeleteFilm">Удалить фильм</button>
            }
            <a href="films" class="btn btn-outline-secondary ms-2">Назад к списку</a>
        </div>
    </div>
}

@code {
    [Parameter]
    public int Id { get; set; }

    private Film? film;
    private Rating? userRating;
    private int ratingValue = 5;
    private bool isLoading = true;
    private bool isSubmittingRating;
    private bool hasRated;
    private string? ratingError;
    private bool _isAdmin = false;
    private bool _isAuthenticated = false;

    // Comments
    private List<Comment> comments = new();
    private string newComment = string.Empty;
    private bool isLoadingComments = false;
    private bool isSubmittingComment = false;
    private string? commentError;

    protected override async Task OnInitializedAsync()
    {
        _isAuthenticated = await AuthService.IsAuthenticatedAsync();
        _isAdmin = await AuthService.IsInRoleAsync("admin");

        film = await FilmService.GetFilmByIdAsync(Id);

        if (_isAuthenticated && film != null)
        {
            userRating = await RatingService.GetMyRatingForFilmAsync(Id);
            hasRated = userRating != null;
        }

        // Load comments
        await LoadComments();

        isLoading = false;
    }

    private async Task LoadComments()
    {
        isLoadingComments = true;
        comments = await CommentService.GetCommentsAsync(Id);
        isLoadingComments = false;
    }

    private async Task SubmitComment()
    {
        if (string.IsNullOrWhiteSpace(newComment))
        {
            commentError = "Комментарий не может быть пустым.";
            return;
        }

        isSubmittingComment = true;
        commentError = null;

        var result = await CommentService.CreateCommentAsync(Id, new CommentCreateDto { Content = newComment.Trim() });

        if (result != null)
        {
            newComment = string.Empty;
            await LoadComments();
            // Refresh film to update comments count
            film = await FilmService.GetFilmByIdAsync(Id);
        }
        else
        {
            commentError = "Не удалось отправить комментарий. Попробуйте снова.";
        }

        isSubmittingComment = false;
    }

    private async Task HandleCommentKeyPress(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await SubmitComment();
        }
    }

    private async Task SubmitRating()
    {
        if (ratingValue < 1 || ratingValue > 10)
        {
            ratingError = "Rating must be between 1 and 10";
            return;
        }

        isSubmittingRating = true;
        ratingError = null;

        var result = await RatingService.CreateRatingAsync(new RatingCreateDto { Value = ratingValue, FilmId = Id });

        if (result != null)
        {
            hasRated = true;
            userRating = result;
            film = await FilmService.GetFilmByIdAsync(Id);
        }
        else
        {
            ratingError = "Failed to submit rating. You may have already rated this film.";
        }

        isSubmittingRating = false;
    }

    private async Task DeleteFilm()
    {
        if (await JSRuntime.InvokeAsync<bool>("eval", "confirm('Are you sure you want to delete this film?')"))
        {
            var success = await FilmService.DeleteFilmAsync(Id);
            if (success)
            {
                Navigation.NavigateTo("/films");
            }
        }
    }
}