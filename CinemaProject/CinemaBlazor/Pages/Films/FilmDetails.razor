@page "/films/{id:int}"
@layout MainLayout
@inject IFilmService FilmService
@inject IRatingService RatingService
@inject IAuthService AuthService
@inject NavigationManager Navigation
@inject IJSRuntime JSRuntime

<PageTitle>Film Details - CinemaBlazor</PageTitle>

@if (isLoading)
{
    <div class="text-center py-5">
        <div class="spinner-border text-primary" role="status">
            <span class="visually-hidden">Loading...</span>
        </div>
    </div>
}
else if (film == null)
{
    <div class="alert alert-danger">Film not found.</div>
}
else
{
    <div class="row">
        <div class="col-md-4">
            @if (!string.IsNullOrEmpty(film.ImageUrl))
            {
                <img src="@film.ImageUrl" class="img-fluid rounded shadow" alt="@film.Name" />
            }
            else
            {
                <div class="bg-secondary text-white d-flex align-items-center justify-content-center rounded shadow"
                     style="height: 300px;">
                    <span class="bi bi-film" style="font-size: 5rem;"></span>
                </div>
            }
        </div>
        <div class="col-md-8">
            <h2>@film.Name</h2>
            @if (film.Genre != null)
            {
                <span class="badge bg-primary">@film.Genre.Name</span>
            }
            <span class="badge bg-secondary ms-2">@film.ReleaseDate.ToString("MMMM dd, yyyy")</span>

            @if (film.Author != null)
            {
                <p class="text-muted mt-2">
                    <small>Created by: @film.Author.Name @film.Author.Surname</small>
                </p>
            }

            <div class="mt-3">
                <h4>Rating:
                    @if (film.Ratings != null && film.Ratings.Any())
                    {
                        <span class="text-warning">⭐ @film.Ratings.Average(r => r.Value).ToString("F1")/10</span>
                        <span class="text-muted">(@film.Ratings.Count ratings)</span>
                    }
                    else
                    {
                        <span class="text-muted">No ratings yet</span>
                    }
                </h4>
            </div>

            <hr />

            <h5>Description</h5>
            <p>@(film.Description ?? "No description available.")</p>

            @if (AuthService.IsAuthenticated())
            {
                <hr />
                <h5>Your Rating</h5>
                @if (userRating != null)
                {
                    <p>You rated this film: <strong>@userRating.Value/10</strong></p>
                }
                else if (!hasRated)
                {
                    <div class="mb-3">
                        <label class="form-label">Rate this film (1-10):</label>
                        <input type="number" class="form-control" min="1" max="10" @bind="ratingValue" />
                    </div>
                    @if (!string.IsNullOrEmpty(ratingError))
                    {
                        <div class="alert alert-danger">@ratingError</div>
                    }
                    <button class="btn btn-warning" @onclick="SubmitRating" disabled="@isSubmittingRating">
                        @if (isSubmittingRating)
                        {
                            <span class="spinner-border spinner-border-sm me-2"></span>
                        }
                        Submit Rating
                    </button>
                }
            }
            else
            {
                <p class="text-muted"><a href="login">Login</a> to rate this film.</p>
            }

            <hr />

            @if (AuthService.IsInRole("admin"))
            {
                <a href="films/@film.Id/edit" class="btn btn-primary">Edit Film</a>
                <button class="btn btn-danger ms-2" @onclick="DeleteFilm">Delete Film</button>
            }
            <a href="films" class="btn btn-outline-secondary ms-2">Back to List</a>
        </div>
    </div>
}

@code {
    [Parameter]
    public int Id { get; set; }

    private Film? film;
    private Rating? userRating;
    private int ratingValue = 5;
    private bool isLoading = true;
    private bool isSubmittingRating;
    private bool hasRated;
    private string? ratingError;

    protected override async Task OnInitializedAsync()
    {
        film = await FilmService.GetFilmByIdAsync(Id);

        if (await AuthService.IsAuthenticatedAsync() && film != null)
        {
            userRating = await RatingService.GetMyRatingForFilmAsync(Id);
            hasRated = userRating != null;
        }

        isLoading = false;
    }

    private async Task SubmitRating()
    {
        if (ratingValue < 1 || ratingValue > 10)
        {
            ratingError = "Rating must be between 1 and 10";
            return;
        }

        isSubmittingRating = true;
        ratingError = null;

        var result = await RatingService.CreateRatingAsync(new RatingCreateDto { Value = ratingValue, FilmId = Id });

        if (result != null)
        {
            hasRated = true;
            userRating = result;
            film = await FilmService.GetFilmByIdAsync(Id); // Refresh film data
        }
        else
        {
            ratingError = "Failed to submit rating. You may have already rated this film.";
        }

        isSubmittingRating = false;
    }

    private async Task DeleteFilm()
    {
        if (await JSRuntime.InvokeAsync<bool>("eval", "confirm('Are you sure you want to delete this film?')"))
        {
            var success = await FilmService.DeleteFilmAsync(Id);
            if (success)
            {
                Navigation.NavigateTo("/films");
            }
        }
    }
}