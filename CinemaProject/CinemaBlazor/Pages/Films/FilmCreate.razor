@page "/films/create"
@layout MainLayout
@inject IFilmService FilmService
@inject IGenreService GenreService
@inject NavigationManager Navigation
@inject IAuthService AuthService

<PageTitle>Создать фильм - CinemaBlazor</PageTitle>

<AuthorizeView Roles="admin">
    <Authorized>
        <h3>🎬 Создать новый фильм</h3>

        <div class="card">
            <div class="card-body">
                <EditForm Model="@film" OnValidSubmit="HandleCreate" Context="EditContext">
                    <DataAnnotationsValidator />

                    <div class="mb-3">
                        <label class="form-label">Название фильма *</label>
                        <InputText @bind-Value="film.Name" class="form-control" placeholder="Введите название фильма" />
                        <ValidationMessage For="@(() => film.Name)" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Описание</label>
                        <InputTextArea @bind-Value="film.Description" class="form-control" rows="4"
                                       placeholder="Описание фильма" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Дата выхода *</label>
                        <InputDate @bind-Value="film.ReleaseDate" class="form-control" />
                        <ValidationMessage For="@(() => film.ReleaseDate)" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Жанр *</label>
                        <InputSelect @bind-Value="film.GenreId" class="form-select">
                            <option value="0">Выберите жанр</option>
                            @foreach (var genre in genres)
                            {
                                <option value="@genre.Id">@genre.Name</option>
                            }
                        </InputSelect>
                        <ValidationMessage For="@(() => film.GenreId)" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label">URL изображения</label>
                        <InputText @bind-Value="film.ImageUrl" class="form-control"
                                   placeholder="https://example.com/image.jpg" />
                    </div>

                    @if (!string.IsNullOrEmpty(errorMessage))
                    {
                        <div class="alert alert-danger">@errorMessage</div>
                    }

                    <button type="submit" class="btn btn-primary" disabled="@isLoading">
                        @if (isLoading)
                        {
                            <span class="spinner-border spinner-border-sm me-2"></span>
                        }
                        Создать фильм
                    </button>
                    <a href="films" class="btn btn-outline-secondary ms-2">Отмена</a>
                </EditForm>
            </div>
        </div>
    </Authorized>
    <NotAuthorized>
        <div class="alert alert-warning">Вы должны быть администратором для создания фильмов.</div>
    </NotAuthorized>
</AuthorizeView>

@code {
    private Film film = new() { ReleaseDate = DateTime.Now };
    private List<Genre> genres = new();
    private string? errorMessage;
    private bool isLoading;
    private bool _isAdmin = false;

    protected override async Task OnInitializedAsync()
    {
        _isAdmin = await AuthService.IsInRoleAsync("admin");
        
        if (!_isAdmin)
        {
            return;
        }
        genres = await GenreService.GetAllGenresAsync();
    }

    private async Task HandleCreate()
    {
        if (film.GenreId == 0)
        {
            errorMessage = "Please select a genre";
            return;
        }

        isLoading = true;
        errorMessage = null;

        var result = await FilmService.CreateFilmAsync(film);

        if (result != null)
        {
            Navigation.NavigateTo($"/films/{result.Id}");
        }
        else
        {
            errorMessage = "Failed to create film. Please try again.";
        }

        isLoading = false;
    }
}