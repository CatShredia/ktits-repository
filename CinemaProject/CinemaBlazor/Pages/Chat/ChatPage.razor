@page "/chat"
@using CinemaBlazor.ApiRequests
@using CinemaBlazor.Services
@inject IChatService ChatService
@inject IAuthService AuthService
@inject NavigationManager NavigationManager
@inject IJSRuntime JS
@implements IDisposable

<div class="chat-container">
    <div class="chat-header">
        <h2>Общий чат</h2>
    </div>

    @if (!isAuthenticated)
    {
        <div class="not-authenticated">
            <p>Для доступа к чату необходимо войти в систему</p>
            <a href="/login" class="btn btn-primary">Войти</a>
        </div>
    }
    else if (currentUser == null)
    {
        <div class="loading">Загрузка...</div>
    }
    else if (generalChat == null)
    {
        <div class="loading">Загрузка общего чата...</div>
    }
    else
    {
        <div class="status">
            Статус: @(ChatService.IsConnected ? "✅ Подключен" : "❌ Не подключен")
            <span class="current-user">Вы: @currentUser.FullName</span>
            <a href="/chats" class="btn btn-sm btn-outline-secondary ms-3">Личные чаты</a>
        </div>

        <div class="messages-list">
            @if (ChatService.Messages.Count == 0)
            {
                <div class="no-messages">
                    Пока нет сообщений. Будьте первыми!
                </div>
            }
            else
            {
                @foreach (var msg in ChatService.Messages)
                {
                    var isOwnMessage = msg.SenderName == currentUser?.FullName;
                    <div class="message-item @(isOwnMessage ? "own-message" : "")">
                        <div class="message-header">
                            <strong class="sender-name">@msg.SenderName</strong>
                            <span class="message-time">@msg.CreatedAt.ToString("HH:mm:ss")</span>
                            @if (msg.IsRead && isOwnMessage)
                            {
                                <span class="read-badge" title="Прочитано">✓</span>
                            }
                        </div>
                        <div class="message-text">@msg.Message</div>
                    </div>
                }
            }
        </div>

        <div class="message-input">
            <input @bind="message"
                   @bind:event="oninput"
                   @onkeypress="OnEnterPress"
                   placeholder="Введите сообщение..."
                   disabled="@(ChatService.IsConnected == false)" />
            <button @onclick="SendMessage"
                    disabled="@(string.IsNullOrEmpty(message) || ChatService.IsConnected == false)">
                Отправить
            </button>
        </div>
    }
</div>

@code {
    private CurrentUser? currentUser;
    private Chat? generalChat;
    private string message = "";
    private bool isAuthenticated = false;

    protected override async Task OnInitializedAsync()
    {
        isAuthenticated = await AuthService.IsAuthenticatedAsync();

        if (isAuthenticated)
        {
            ChatService.OnMessageReceived = StateHasChanged;
            ChatService.OnHistoryLoaded = StateHasChanged;
            ChatService.OnChatsUpdate = StateHasChanged;

            await ChatService.Connect();
            currentUser = await ChatService.GetCurrentUserAsync();

            if (currentUser != null)
            {
                await ChatService.Register();
                
                // Сначала получаем общий чат для установки GeneralChatId
                generalChat = await ChatService.GetGeneralChat();
                
                if (generalChat != null)
                {
                    // Подписываемся на общий чат
                    await ChatService.JoinGeneralChat();
                    
                    // Загружаем историю
                    await ChatService.LoadHistory(generalChat.Id);
                    await ChatService.MarkMessagesAsRead(generalChat.Id);
                }
            }
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // Автоскролл к последнему сообщению
        try
        {
            await JS.InvokeVoidAsync("eval", "setTimeout(() => { var el = document.querySelector('.messages-list'); if(el) el.scrollTop = el.scrollHeight; }, 100);");
        }
        catch { }
    }

    private async Task SendMessage()
    {
        if (!string.IsNullOrEmpty(message) && generalChat != null && ChatService.IsConnected)
        {
            await ChatService.SendMessageToChat(generalChat.Id, message);
            message = "";
            StateHasChanged();
        }
    }

    private async Task OnEnterPress(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await SendMessage();
        }
    }

    public void Dispose()
    {
        ChatService.OnMessageReceived = null;
        ChatService.OnHistoryLoaded = null;
        ChatService.OnChatsUpdate = null;
        _ = ChatService.Disconnect();
    }
}
