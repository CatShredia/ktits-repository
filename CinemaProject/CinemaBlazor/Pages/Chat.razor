@page "/chat"
@using CinemaBlazor.Models.Chat
@using CinemaBlazor.Services
@inject IChatService ChatService
@inject ChatHubService ChatHub
@inject IAuthService AuthService
@inject NavigationManager Navigation
@inject IJSRuntime JS
@inject IApiUrlService ApiUrlService
@implements IDisposable

<div class="container-fluid mt-4" @onclick="() => _openMenuConversationId = null">
    <h2>Чат</h2>

    @if (!_isAuthenticated)
    {
        <div class="alert alert-warning">Пожалуйста, войдите в систему для использования чата.</div>
    }
    else if (_currentUser == null)
    {
        <div class="text-center mt-5">
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">Загрузка...</span>
            </div>
            <p class="mt-2">Подключение к чату...</p>
        </div>
    }
    else
    {
        <div class="row">
            <!-- Левая панель: список чатов -->
            <div class="col-md-4">
                <div class="card">
                    <div class="card-header d-flex justify-content-between align-items-center">
                        <h6 class="mb-0">Диалоги</h6>
                        <button class="btn btn-sm btn-primary" @onclick="ShowNewChatModal">
                            <i class="bi bi-plus-lg"></i>
                        </button>
                    </div>
                    <div class="card-body p-0">
                        @if (_conversations.Count == 0)
                        {
                            <p class="text-muted text-center p-3 mb-0">Нет диалогов</p>
                        }
                        else
                        {
                            @foreach (var conv in _conversations.Where(c => c.ConversationTypeName != "Comments"))
                            {
                                var isActive = _selectedConversation?.Id == conv.Id;
                                var otherParticipants = conv.Participants
                                    .Where(p => p.UserId != _currentUser?.Id)
                                    .ToList();
                                var chatName = GetConversationDisplayName(conv);

                                <div class="conversation-item p-2 border-bottom @GetActiveClass(isActive)"
                                     @onclick="() => SelectConversation(conv)" style="cursor:pointer;">
                                    <div class="d-flex justify-content-between align-items-center">
                                        <div class="flex-grow-1 me-2">
                                            <div class="fw-bold text-truncate">
                                                @((MarkupString)GetConversationIcon(conv.ConversationTypeName)) @chatName
                                            </div>
                                            @if (conv.LastMessage != null)
                                            {
                                                <small class="text-muted">@FormatTime(conv.LastMessage.CreatedAt)</small>
                                            }
                                        </div>
                                        <div class="dropdown dropdown-toggle-btn" @onclick:stopPropagation="true">
                                            <button class="btn btn-sm btn-link text-muted p-0" type="button"
                                                    @onclick="() => _openMenuConversationId = conv.Id"
                                                    style="font-size: 1.2rem; line-height: 1;">
                                                <i class="bi bi-three-dots-vertical"></i>
                                            </button>
                                            @if (_openMenuConversationId == conv.Id)
                                            {
                                                <div class="dropdown-menu show dropdown-menu-end" style="position: absolute;">
                                                    @if (conv.ConversationTypeName == "Group")
                                                    {
                                                        <button class="dropdown-item" @onclick="() => OpenGroupSettings(conv)">
                                                            <i class="bi bi-gear me-2"></i>Настройка группы
                                                        </button>
                                                    }
                                                    <button class="dropdown-item text-danger" @onclick="() => ShowDeleteConfirm(conv)">
                                                        <i class="bi bi-trash me-2"></i>Удалить чат
                                                    </button>
                                                </div>
                                            }
                                        </div>
                                    </div>
                                    @if (conv.LastMessage != null)
                                    {
                                        <small class="text-muted text-truncate d-block">@conv.LastMessage.Content</small>
                                    }
                                </div>
                            }
                        }
                    </div>
                </div>
            </div>

            <!-- Правая панель: сообщения -->
            <div class="col-md-8">
                @if (_selectedConversation == null)
                {
                    <div class="card h-100 d-flex align-items-center justify-content-center">
                        <div class="text-center text-muted p-5">
                            <i class="bi bi-chat-text" style="font-size: 3rem;"></i>
                            <p class="mt-3">Выберите диалог или создайте новый</p>
                        </div>
                    </div>
                }
                else
                {
                    var otherParticipants = _selectedConversation.Participants
                        .Where(p => p.UserId != _currentUser?.Id)
                        .ToList();
                    var chatName = GetConversationDisplayName(_selectedConversation);

                    <div class="card">
                        <div class="card-header">
                            <h6 class="mb-0">
                                @((MarkupString)GetConversationIcon(_selectedConversation.ConversationTypeName)) @chatName
                            </h6>
                            @if (!string.IsNullOrEmpty(_typingUsers))
                            {
                                <small class="text-muted fst-italic">@_typingUsers печатает...</small>
                            }

                            @if (_selectedConversation.ConversationTypeName != "Direct")
                            {
                                <div class="mt-2">
                                    <div class="d-flex justify-content-between align-items-center">
                                        <button class="btn btn-sm btn-link p-0 text-muted"
                                                @onclick="() => _showParticipants = !_showParticipants" style="font-size: 0.85rem;">
                                            <i class="bi @(_showParticipants ? "bi-chevron-down" : "bi-chevron-right")"></i>
                                            Участники (@_selectedConversation.Participants.Count)
                                        </button>
                                        @if (_showParticipants && CanManageParticipants())
                                        {
                                            <button class="btn btn-sm btn-link p-0 text-primary"
                                                    @onclick="() => OpenAddParticipantModal()" style="font-size: 0.85rem;"
                                                    title="Добавить участника">
                                                <i class="bi bi-person-plus"></i>
                                            </button>
                                        }
                                    </div>
                                    @if (CanTransferOwnership())
                                    {
                                        <button class="btn btn-sm btn-link p-0 text-warning me-2"
                                                @onclick="() => _showTransferOwnershipModal = true" style="font-size: 0.85rem;"
                                                title="Передать права владельца">
                                            <i class="bi bi-arrow-repeat"></i>
                                        </button>
                                    }
                                    @if (_showParticipants)
                                    {
                                        <div class="list-group list-group-flush mt-1" style="font-size: 0.85rem;">
                                            @foreach (var participant in _selectedConversation.Participants)
                                            {
                                                <div class="list-group-item px-2 py-1 d-flex justify-content-between align-items-center">
                                                    <span>
                                                        @if (participant.UserId == _currentUser?.Id)
                                                        {
                                                            <i class="bi bi-person-badge text-primary me-1"></i>
                                                        }
                                                        @participant.FullName
                                                    </span>
                                                    <div class="d-flex align-items-center">
                                                        <span
                                                        class="badge @(GetRoleBadgeClass(participant.RoleName)) me-2">@participant.RoleName</span>
                                                        @if (participant.UserId == _currentUser?.Id)
                                                        {
                                                            <span class="badge bg-secondary">Вы</span>
                                                        }
                                                        else
                                                        {
                                                            @if (IsOwner() && _selectedConversation.ConversationTypeName != "Direct")
                                                            {
                                                                <button class="btn btn-sm btn-link p-0 text-warning ms-1"
                                                                        @onclick="() => OpenChangeRoleModal(participant)" style="font-size: 0.8rem;"
                                                                        title="Сменить роль">
                                                                    <i class="bi bi-person-gear"></i>
                                                                </button>
                                                            }

                                                            @if (CanManageParticipants())
                                                            {
                                                                <button class="btn btn-sm btn-link text-danger p-0 ms-2"
                                                                        @onclick="() => RemoveParticipantAsync(participant.UserId)"
                                                                        title="Удалить участника" style="font-size: 0.8rem;">
                                                                    <i class="bi bi-x-lg"></i>
                                                                </button>
                                                            }
                                                        }
                                                    </div>
                                                </div>
                                            }
                                        </div>
                                    }
                                </div>
                            }
                        </div>
                        <div class="card-body" id="messages-container" style="height: 400px; overflow-y: auto;">
                            @if (_messages.Count == 0)
                            {
                                <p class="text-muted text-center">Нет сообщений</p>
                            }
                            else
                            {
                                @foreach (var msg in _messages)
                                {
                                    var isMine = msg.SenderId == _currentUser?.Id;
                                    <div class="d-flex @(isMine ? "justify-content-end" : "justify-content-start") mb-2">
                                        <div class="@(isMine ? "bg-primary text-white" : "bg-light") rounded p-2"
                                             style="max-width: 70%;">
                                            @if (!isMine)
                                            {
                                                <small class="fw-bold d-block">@msg.SenderName</small>
                                            }
                                            @if (_editingMessageId == msg.Id)
                                            {
                                                <input type="text" class="form-control form-control-sm" value="@_editMessageText"
                                                       @oninput="OnEditMessageInput" @onkeydown="HandleEditKeyDown" @onblur="CommitEditMessage"
                                                       @ref="_editMessageInput" style="font-size: 0.875rem;" />
                                            }
                                            else
                                            {
                                                <div>@msg.Content</div>
                                            }
                                            @if (!string.IsNullOrEmpty(msg.ImageUrl))
                                            {
                                                var imgUrl = ApiUrlService.GetImageUrl(msg.ImageUrl!);
                                                <img src="@imgUrl" alt="image" class="img-fluid rounded mt-1"
                                                     style="max-height: 300px; max-width: 100%; object-fit: contain; cursor: pointer;"
                                                     @onclick="() => ShowImageModal(imgUrl)" />
                                            }
                                            <small class="@(isMine ? "text-white-50" : "text-muted")" style="font-size: 0.75rem;">
                                                @FormatTime(msg.CreatedAt)
                                            </small>
                                            @{
                                                var canDeleteOwn = CanDeleteOwnMessage();
                                                var canDeleteOther = CanDeleteOtherMessage();
                                                var canDeleteThisMessage = (isMine && canDeleteOwn) || (!isMine && canDeleteOther);
                                                var canEditThisMessage = isMine && CanEditOwnMessage();
                                            }
                                            @if (canEditThisMessage)
                                            {
                                                <button class="btn btn-sm btn-link @(isMine ? "text-white-50" : "text-secondary") p-0 ms-2"
                                                        style="font-size: 0.75rem;" @onclick="() => StartEditMessage(msg)"
                                                        title="Редактировать">
                                                    <i class="bi bi-pencil"></i>
                                                </button>
                                            }
                                            @if (canDeleteThisMessage)
                                            {
                                                <button class="btn btn-sm btn-link @(isMine ? "text-white-50" : "text-danger") p-0 ms-2"
                                                        style="font-size: 0.75rem;" @onclick="() => DeleteMessage(msg.Id)" title="Удалить">
                                                    <i class="bi bi-trash"></i>
                                                </button>
                                            }
                                            @if (_selectedConversation.ConversationTypeName == "Channel")
                                            {
                                                <div class="mt-1">
                                                    <button class="btn btn-sm btn-link text-muted p-0" style="font-size: 0.75rem;"
                                                            @onclick="() => LoadCommentsPreview(msg.Id)">
                                                        💬 @_commentsCounts.GetValueOrDefault(msg.Id, 0)
                                                    </button>
                                                    @if (_commentsPreviews.TryGetValue(msg.Id, out var previews) && previews.Count > 0)
                                                    {
                                                        <div class="mt-1 ms-3" style="border-left: 2px solid #dee2e6; padding-left: 8px;">
                                                            @foreach (var preview in previews.Take(2))
                                                            {
                                                                <div class="text-muted" style="font-size: 0.75rem;">
                                                                    <strong>@preview.SenderName:</strong> @preview.Content
                                                                </div>
                                                            }
                                                            @if (previews.Count > 2)
                                                            {
                                                                <button class="btn btn-link btn-sm p-0" style="font-size: 0.75rem;"
                                                                        @onclick="() => OpenCommentsModal(msg.Id)">
                                                                    Показать все @_commentsCounts.GetValueOrDefault(msg.Id, 0) комментариев
                                                                </button>
                                                            }
                                                            else
                                                            {
                                                                <button class="btn btn-link btn-sm p-0" style="font-size: 0.75rem;"
                                                                        @onclick="() => OpenCommentsModal(msg.Id)">
                                                                    Все комментарии
                                                                </button>
                                                            }
                                                        </div>
                                                    }
                                                    else
                                                    {
                                                        <button class="btn btn-link btn-sm p-0 text-primary" style="font-size: 0.75rem;"
                                                                @onclick="() => OpenCommentsModal(msg.Id)">
                                                            <i class="bi bi-plus-circle"></i> Обсудить
                                                        </button>
                                                    }
                                                </div>
                                            }
                                        </div>
                                    </div>
                                }
                            }
                        </div>
                        <div class="card-footer">
                            @if (CanSendMessage())
                            {
                                @if (!string.IsNullOrEmpty(_imagePreview))
                                {
                                    <div class="mb-2 position-relative d-inline-block">
                                        <img src="@_imagePreview" class="img-thumbnail" style="max-height: 80px; max-width: 150px;"
                                             alt="Preview" />
                                        <button class="btn btn-sm btn-danger position-absolute top-0 start-100 translate-middle p-0"
                                                style="width: 20px; height: 20px; border-radius: 50%; font-size: 0.7rem;"
                                                @onclick="ClearImage">
                                            <i class="bi bi-x"></i>
                                        </button>
                                    </div>
                                }
                                <div class="input-group">
                                    <button class="btn btn-outline-secondary" @onclick="TriggerFilePicker"
                                            title="Прикрепить изображение">
                                        <i class="bi bi-paperclip"></i>
                                    </button>
                                    <input type="text" class="form-control" placeholder="Введите сообщение..."
                                           @bind="_newMessagesText" @onkeydown="HandleKeyDown" @onkeyup="OnTyping" />
                                    <button class="btn btn-primary" @onclick="SendMessageAsync"
                                            disabled="@(string.IsNullOrWhiteSpace(_newMessagesText) && _chatImageFile == null)">
                                        <i class="bi bi-send"></i> Отправить
                                    </button>
                                </div>
                                <InputFile OnChange="HandleChatImageSelected" id="chat-image-input" class="d-none"
                                           accept="image/png, image/jpeg, image/jpg, image/webp" />
                            }
                            else
                            {
                                <div class="text-muted text-center fst-italic">Только чтение</div>
                            }
                        </div>
                    </div>
                }
            </div>
        </div>
    }
</div>

<!-- Модальное окно: новый диалог -->
@if (_showNewChatModal)
{
    <div class="modal fade show d-block" style="background-color: rgba(0,0,0,0.5);" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Новый диалог</h5>
                    <button type="button" class="btn-close" @onclick="() => _showNewChatModal = false"></button>
                </div>
                <div class="modal-body">
                    <!-- Выбор типа чата -->
                    <div class="mb-3">
                        <label class="form-label">Тип чата</label>
                        <select class="form-select" @bind="_newConversationType">
                            <option value="Direct">Личный (Direct)</option>
                            <option value="Group">Групповой (Group)</option>
                            <option value="Channel">Канал (Channel)</option>
                        </select>
                    </div>

                    @if (_newConversationType != "Channel")
                    {
                        <div>
                            <div class="input-group mb-3">
                                <input type="text" class="form-control" placeholder="Поиск по логину..." @bind="_searchLogin"
                                       @onkeydown="HandleSearchKeyDown" />
                                <button class="btn btn-outline-secondary" @onclick="SearchUser">Найти</button>
                            </div>

                            @if (_searchResult != null)
                            {
                                <div class="card mb-3">
                                    <div class="card-body">
                                        <div class="form-check">
                                            <input class="form-check-input" type="checkbox"
                                                   @onchange="() => ToggleUserSelection(_searchResult.Id)"
                                                   checked="@_selectedUserIds.Contains(_searchResult.Id)" />
                                            <label class="form-check-label">
                                                @_searchResult.FullName (@_searchResult.Login)
                                            </label>
                                        </div>
                                    </div>
                                </div>
                            }

                            @if (_searchError != null)
                            {
                                <div class="alert alert-danger">@_searchError</div>
                            }

                            @if (_selectedUserIds.Count > 0)
                            {
                                <p class="text-muted">Выбрано пользователей: @_selectedUserIds.Count</p>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="alert alert-info">Канал будет создан без участников. Вы сможете добавить их позже.
                        </div>
                    }
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" @onclick="() => _showNewChatModal = false">Отмена
                    </button>
                    <button type="button" class="btn btn-primary" @onclick="CreateConversation"
                            disabled="@IsCreateDisabled">Создать
                    </button>
                </div>
            </div>
        </div>
    </div>
}

<!-- Модальное окно: настройка группы -->
@if (_showGroupSettingsModal)
{
    <div class="modal fade show d-block" style="background-color: rgba(0,0,0,0.5);" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Настройка группы</h5>
                    <button type="button" class="btn-close" @onclick="() => _showGroupSettingsModal = false"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label">Название группы</label>
                        <input type="text" class="form-control" @bind="_groupSettingsName" />
                    </div>

                    <h6>Участники</h6>
                    @if (_groupSettingsParticipants != null)
                    {
                        @foreach (var participant in _groupSettingsParticipants)
                        {
                            <div class="d-flex justify-content-between align-items-center mb-2 p-2 border rounded">
                                <span>
                                    @participant.FullName (@participant.Login)
                                    <span class="badge @(GetRoleBadgeClass(participant.RoleName)) ms-2">@participant.RoleName</span>
                                </span>
                                @if (participant.UserId != _currentUser?.Id)
                                {
                                    <button class="btn btn-sm btn-danger" @onclick="() => RemoveParticipant(participant.UserId)">
                                        <i class="bi bi-x-lg"></i>
                                    </button>
                                }
                                else
                                {
                                    <small class="text-muted">(Вы)</small>
                                }
                            </div>
                        }
                    }

                    <hr />
                    <h6>Добавить участника</h6>
                    <div class="input-group mb-3">
                        <input type="text" class="form-control" placeholder="Поиск по логину..."
                               @bind="_addParticipantLogin" />
                        <button class="btn btn-outline-secondary" @onclick="SearchUserForGroup">Найти</button>
                    </div>

                    @if (_addSearchResult != null)
                    {
                        <div class="card mb-3">
                            <div class="card-body">
                                <div class="d-flex justify-content-between align-items-center">
                                    <span>@_addSearchResult.FullName (@_addSearchResult.Login)</span>
                                    <button class="btn btn-sm btn-primary"
                                            @onclick="() => AddParticipantToGroup(_addSearchResult.Id)">
                                        <i class="bi bi-plus-lg"></i> Добавить
                                    </button>
                                </div>
                            </div>
                        </div>
                    }
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" @onclick="() => _showGroupSettingsModal = false">Закрыть
                    </button>
                    <button type="button" class="btn btn-primary" @onclick="SaveGroupSettings">Сохранить</button>
                </div>
            </div>
        </div>
    </div>
}

<!-- Модальное окно: подтверждение удаления -->
@if (_showDeleteConfirmModal)
{
    <div class="modal fade show d-block" style="background-color: rgba(0,0,0,0.5);" tabindex="-1">
        <div class="modal-dialog modal-sm">
            <div class="modal-content">
                <div class="modal-header bg-danger text-white">
                    <h5 class="modal-title">Удалить чат</h5>
                    <button type="button" class="btn-close btn-close-white"
                            @onclick="() => _showDeleteConfirmModal = false"></button>
                </div>
                <div class="modal-body">
                    <p>Вы уверены, что хотите удалить этот чат?</p>
                    <p class="text-muted small">Все сообщения будут удалены без возможности восстановления.</p>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" @onclick="() => _showDeleteConfirmModal = false">Отмена
                    </button>
                    <button type="button" class="btn btn-danger" @onclick="DeleteConversation">Удалить</button>
                </div>
            </div>
        </div>
    </div>
}

<!-- Модальное окно: добавление участника -->
@if (_showAddParticipantModal)
{
    <div class="modal fade show d-block" style="background-color: rgba(0,0,0,0.5);" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Добавить участника</h5>
                    <button type="button" class="btn-close" @onclick="() => _showAddParticipantModal = false"></button>
                </div>
                <div class="modal-body">
                    <div class="input-group mb-3">
                        <input type="text" class="form-control" placeholder="Поиск по логину..."
                               @bind="_addParticipantLoginNew" @onkeydown="HandleAddParticipantKeyDown" />
                        <button class="btn btn-outline-secondary" @onclick="SearchUserForAdd">Найти</button>
                    </div>

                    @if (_addParticipantSearchResult != null)
                    {
                        <div class="card mb-3">
                            <div class="card-body">
                                <div class="d-flex justify-content-between align-items-center">
                                    <span>@_addParticipantSearchResult.FullName (@_addParticipantSearchResult.Login)</span>
                                    <button class="btn btn-sm btn-primary"
                                            @onclick="() => AddParticipant(_addParticipantSearchResult.Id)">
                                        <i class="bi bi-plus-lg"></i> Добавить
                                    </button>
                                </div>
                            </div>
                        </div>
                    }

                    @if (_addParticipantError != null)
                    {
                        <div class="alert alert-danger">@_addParticipantError</div>
                    }
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary"
                            @onclick="() => _showAddParticipantModal = false">Закрыть
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@if (_showTransferOwnershipModal)
{
    <div class="modal fade show d-block" style="background-color: rgba(0,0,0,0.5);" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header bg-warning">
                    <h5 class="modal-title">Передать права владельца</h5>
                    <button type="button" class="btn-close" @onclick="() => _showTransferOwnershipModal = false"></button>
                </div>
                <div class="modal-body">
                    <p>Выберите пользователя:</p>
                    @if (_selectedConversation != null)
                    {
                        @foreach (var participant in _selectedConversation.Participants.Where(p => p.UserId !=
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                           _currentUser?.Id))
                        {
                            <div class="d-flex justify-content-between align-items-center mb-2 p-2 border rounded">
                                <span>
                                    @participant.FullName
                                    <span class="badge @(GetRoleBadgeClass(participant.RoleName)) ms-2">@participant.RoleName</span>
                                </span>
                                <button class="btn btn-sm btn-warning" @onclick="() => TransferOwnership(participant.UserId)">
                                    <i class="bi bi-arrow-repeat"></i> Передать
                                </button>
                            </div>
                        }
                    }
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary"
                            @onclick="() => _showTransferOwnershipModal = false">Отмена
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@if (_showCommentsModal)
{
    <div class="modal fade show d-block" style="background-color: rgba(0,0,0,0.5);" tabindex="-1">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Комментарии</h5>
                    <button type="button" class="btn-close" @onclick="() => _showCommentsModal = false"></button>
                </div>
                <div class="modal-body" style="max-height: 400px; overflow-y: auto;">
                    @if (_commentsMessages.Count == 0)
                    {
                        <p class="text-muted text-center">Нет комментариев</p>
                    }
                    else
                    {
                        @foreach (var msg in _commentsMessages)
                        {
                            <div class="mb-2 p-2 @(msg.SenderId == _currentUser?.Id ? "bg-light" : "") rounded">
                                <strong>@msg.SenderName</strong>
                                <div>@msg.Content</div>
                                <small class="text-muted">@msg.CreatedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</small>
                            </div>
                        }
                    }
                </div>
                <div class="modal-footer">
                    <div class="input-group">
                        <input type="text" class="form-control" placeholder="Написать комментарий..."
                               @bind="_newCommentText" @onkeydown="HandleCommentKeyDown" />
                        <button class="btn btn-primary" @onclick="SendComment"
                                disabled="@(string.IsNullOrWhiteSpace(_newCommentText))">
                            <i class="bi bi-send"></i>
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
}

@if (_showChangeRoleModal && _changeRoleParticipant != null)
{
    <div class="modal fade show d-block" style="background-color: rgba(0,0,0,0.5);" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header bg-info">
                    <h5 class="modal-title">Сменить роль: @_changeRoleParticipant.FullName</h5>
                    <button type="button" class="btn-close" @onclick="() => CloseChangeRoleModal()"></button>
                </div>
                <div class="modal-body">
                    <p>Текущая роль: <span
                        class="badge @(GetRoleBadgeClass(_changeRoleParticipant.RoleName))">@_changeRoleParticipant.RoleName</span>
                    </p>
                    <p>Выберите новую роль:</p>
                    <div class="list-group">
                        @foreach (var role in new[] { "Moderator", "Member" }.Where(r => r !=
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                 _changeRoleParticipant.RoleName))
                        {
                            <button
                                class="list-group-item list-group-item-action d-flex justify-content-between align-items-center"
                                @onclick="() => ChangeRole(role)">
                                <span>@GetRoleDisplayName(role)</span>
                                <span class="badge @(GetRoleBadgeClass(role))">@role</span>
                            </button>
                        }
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" @onclick="() => CloseChangeRoleModal()">Отмена
                    </button>
                </div>
            </div>
        </div>
    </div>
}

<!-- Модальное окно: просмотр изображения -->
@if (_showImageModal)
{
    <div class="modal fade show d-block" style="background-color: rgba(0,0,0,0.5);" tabindex="-1"
         @onclick="() => _showImageModal = false">
        <div class="modal-dialog modal-lg modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Изображение</h5>
                    <button type="button" class="btn-close" @onclick="() => _showImageModal = false"></button>
                </div>
                <div class="modal-body text-center">
                    <img src="@_imageModalUrl" class="img-fluid rounded"
                         style="max-height: 80vh; max-width: 100%; object-fit: contain;" alt="Image" />
                </div>
            </div>
        </div>
    </div>
}

<style>
    .conversation-item:hover {
        background-color: #f8f9fa;
    }

    .conversation-item.active {
        background-color: #e7f1ff;
    }

    .conversation-item .dropdown-menu {
        z-index: 1050;
        box-shadow: 0 0.125rem 0.25rem rgba(0, 0, 0, 0.075);
    }

    .conversation-item .dropdown-toggle-btn {
        opacity: 0;
        transition: opacity 0.15s ease-in-out;
    }

    .conversation-item:hover .dropdown-toggle-btn {
        opacity: 1;
    }
</style>

@code {
    private UserChatDto? _currentUser;
    private List<ConversationDto> _conversations = new();
    private ConversationDto? _selectedConversation;
    private List<MessageDto> _messages = new();
    private string _newMessagesText = "";
    private IBrowserFile? _chatImageFile;
    private string? _imagePreview;
    private bool _isAuthenticated;
    private bool _showNewChatModal;
    private string _searchLogin = "";
    private UserChatDto? _searchResult;
    private string? _searchError;
    private HashSet<int> _selectedUserIds = new();
    private HashSet<int> _typingUserIds = new();
    private string? _typingUsers;

    // Для редактирования сообщений
    private int? _editingMessageId;
    private string _editMessageText = "";
    private ElementReference _editMessageInput;

    // Для меню чатов
    private int? _openMenuConversationId;

    // Для настройки группы
    private bool _showGroupSettingsModal;
    private ConversationDto? _groupSettingsConversation;
    private string? _groupSettingsName;
    private List<ParticipantDto>? _groupSettingsParticipants;
    private string _addParticipantLogin = "";
    private UserChatDto? _addSearchResult;

    // Для удаления чата
    private bool _showDeleteConfirmModal;
    private ConversationDto? _deleteConversation;

    // Для создания нового чата
    private string _newConversationType = "Direct";

    private bool IsCreateDisabled => _newConversationType switch
    {
        "Channel" => false,
        "Direct" => _selectedUserIds.Count != 1,
        _ => _selectedUserIds.Count == 0
    };

    // Для отображения участников
    private bool _showParticipants;

    // Для добавления участника
    private bool _showAddParticipantModal;
    private string _addParticipantLoginNew = "";
    private UserChatDto? _addParticipantSearchResult;
    private string? _addParticipantError;

    // Для передачи прав владельца
    private bool _showTransferOwnershipModal;

    // Для смены роли
    private bool _showChangeRoleModal;
    private ParticipantDto? _changeRoleParticipant;

    // Для модального окна изображения
    private bool _showImageModal;
    private string _imageModalUrl = "";

    private void ShowImageModal(string imageUrl)
    {
        _imageModalUrl = imageUrl;
        _showImageModal = true;
    }

    private string ApiBaseUrl => ApiUrlService.GetBaseUrl();

    // Для комментариев канала
    private HashSet<int> _expandedCommentsMessages = new();
    private Dictionary<int, List<CommentPreviewDto>> _commentsPreviews = new();
    private Dictionary<int, int> _commentsCounts = new();
    private bool _showCommentsModal;
    private int _commentsModalMessageId;
    private List<MessageDto> _commentsMessages = new();
    private ConversationDto? _commentsConversation;
    private string _newCommentText = "";

    protected override async Task OnInitializedAsync()
    {
        _isAuthenticated = await AuthService.IsAuthenticatedAsync();
        if (!_isAuthenticated)
            return;

        await LoadConversationsAsync();

        // Load comment previews for Channel messages
        foreach (var conv in _conversations.Where(c => c.ConversationTypeName == "Channel"))
        {
            var messages = await ChatService.GetMessagesAsync(conv.Id);
            foreach (var msg in messages)
            {
                await LoadCommentsPreview(msg.Id);
            }
        }

        // Подключение к SignalR
        var token = await ChatService.GetTokenAsync();
        if (!string.IsNullOrEmpty(token))
        {
            ChatHub.OnMessageReceived += OnMessageReceived;
            ChatHub.OnUserTyping += OnUserTypingEvent;
            ChatHub.OnMessageDeleted += OnMessageDeletedEvent;
            ChatHub.OnMessageEdited += OnMessageEditedEvent;
            ChatHub.OnConversationCreated += OnConversationCreatedEvent;
            await ChatHub.StartAsync(token);
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && _currentUser != null)
        {
            // Подключение к текущему чату
            if (_selectedConversation != null)
            {
                await ChatHub.JoinConversationAsync(_selectedConversation.Id);
            }
        }
    }

    private async Task LoadConversationsAsync()
    {
        _currentUser = await ChatService.GetCurrentUserAsync();
        _conversations = await ChatService.GetConversationsAsync();
        StateHasChanged();
    }

    private async Task SelectConversation(ConversationDto conv)
    {
        // Покинуть предыдущий чат
        if (_selectedConversation != null)
        {
            await ChatHub.LeaveConversationAsync(_selectedConversation.Id);
        }

        _selectedConversation = conv;
        _messages = await ChatService.GetMessagesAsync(conv.Id);
        _typingUserIds.Clear();
        _typingUsers = null;
        _showParticipants = false;
        StateHasChanged();

        await ChatHub.JoinConversationAsync(conv.Id);
    }

    private async Task SendMessageAsync()
    {
        if (_selectedConversation == null)
            return;

        if (string.IsNullOrWhiteSpace(_newMessagesText) && _chatImageFile == null)
            return;

        if (_chatImageFile != null)
        {
            var result = await ChatService.SendMessageWithImageAsync(_selectedConversation.Id,
                string.IsNullOrWhiteSpace(_newMessagesText) ? null : _newMessagesText.Trim(), _chatImageFile);
            _chatImageFile = null;
            _imagePreview = null;
        }
        else
        {
            await ChatHub.SendMessageAsync(_selectedConversation.Id, _newMessagesText.Trim());
        }

        _newMessagesText = "";
        StateHasChanged();
    }

    private async Task OnTyping(KeyboardEventArgs args)
    {
        if (_selectedConversation != null)
        {
            await ChatHub.SendTypingAsync(_selectedConversation.Id);
        }
    }

    private void HandleKeyDown(KeyboardEventArgs args)
    {
        if (args.Key == "Enter" && !string.IsNullOrWhiteSpace(_newMessagesText))
        {
            SendMessageAsync();
        }
    }

    private async Task HandleChatImageSelected(InputFileChangeEventArgs e)
    {
        var file = e.File;
        if (!file.ContentType.StartsWith("image/"))
        {
            return;
        }

        if (file.Size > 5 * 1024 * 1024)
        {
            return;
        }

        _chatImageFile = file;

        using var stream = file.OpenReadStream(maxAllowedSize: 5 * 1024 * 1024);
        using var memoryStream = new MemoryStream();
        await stream.CopyToAsync(memoryStream);
        var bytes = memoryStream.ToArray();
        _imagePreview = $"data:{file.ContentType};base64,{Convert.ToBase64String(bytes)}";
        StateHasChanged();
    }

    private async Task TriggerFilePicker()
    {
        await JS.InvokeVoidAsync("eval", "document.getElementById('chat-image-input').click();");
    }

    private void ClearImage()
    {
        _chatImageFile = null;
        _imagePreview = null;
        StateHasChanged();
    }

    private async Task DeleteMessage(int messageId)
    {
        if (_selectedConversation == null)
            return;

        await ChatHub.DeleteMessageAsync(messageId, _selectedConversation.Id);
    }

    private void StartEditMessage(MessageDto message)
    {
        Console.WriteLine($"[Chat] StartEditMessage: messageId={message.Id}, convId={_selectedConversation?.Id}, content='{message.Content}'");
        _editingMessageId = message.Id;
        _editMessageText = message.Content;
        StateHasChanged();

        // Фокус на input после рендера
        _ = Task.Run(async () =>
        {
            await Task.Delay(50);
            await JS.InvokeVoidAsync("eval", $"document.querySelector('input[style*=\"font-size: 0.875rem\"]')?.focus();");
        });
    }

    private void OnEditMessageInput(ChangeEventArgs e)
    {
        if (e.Value != null)
            _editMessageText = e.Value.ToString() ?? "";
        StateHasChanged();
    }

    private async Task HandleEditKeyDown(KeyboardEventArgs args)
    {
        if (args.Key == "Enter")
        {
            Console.WriteLine($"[Chat] HandleEditKeyDown: Enter pressed, calling CommitEditMessage");
            await CommitEditMessage();
        }
        else if (args.Key == "Escape")
        {
            Console.WriteLine($"[Chat] HandleEditKeyDown: Escape pressed, cancelling");
            CancelEditMessage();
        }
    }

    private async Task CommitEditMessage()
    {
        Console.WriteLine($"[Chat] CommitEditMessage: editingMessageId={_editingMessageId}, convId={_selectedConversation?.Id}, newText='{_editMessageText}'");

        if (_editingMessageId == null || _selectedConversation == null)
        {
            Console.WriteLine($"[Chat] CommitEditMessage: ABORT — null check failed");
            return;
        }
        if (string.IsNullOrWhiteSpace(_editMessageText))
        {
            Console.WriteLine($"[Chat] CommitEditMessage: ABORT — empty text");
            return;
        }

        var trimmedText = _editMessageText.Trim();
        Console.WriteLine($"[Chat] CommitEditMessage: calling ChatHub.EditMessageAsync(convId={_selectedConversation.Id}, msgId={_editingMessageId.Value}, content='{trimmedText}')");

        try
        {
            await ChatHub.EditMessageAsync(_editingMessageId.Value, _selectedConversation.Id, trimmedText);
            Console.WriteLine($"[Chat] CommitEditMessage: EditMessageAsync SUCCESS");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[Chat] CommitEditMessage: EXCEPTION — {ex.Message}");
        }

        _editingMessageId = null;
        _editMessageText = "";
        StateHasChanged();
        Console.WriteLine($"[Chat] CommitEditMessage: state cleared, DONE");
    }

    private void CancelEditMessage()
    {
        Console.WriteLine($"[Chat] CancelEditMessage: editingMessageId={_editingMessageId}");
        _editingMessageId = null;
        _editMessageText = "";
        StateHasChanged();
    }

    private void OnMessageEditedEvent(MessageResponse message)
    {
        Console.WriteLine($"[Chat] OnMessageEditedEvent: messageId={message.Id}, convId={message.ConversationId}, newContent='{message.Content}'");

        if (_selectedConversation?.Id == message.ConversationId)
        {
            var existingMsg = _messages.FirstOrDefault(m => m.Id == message.Id);
            if (existingMsg != null)
            {
                existingMsg.Content = message.Content;
                existingMsg.UpdatedAt = message.UpdatedAt;
                Console.WriteLine($"[Chat] OnMessageEditedEvent: updated message in _messages");
                StateHasChanged();
            }
        }

        // Обновить в списке диалогов, если это последнее сообщение
        var conv = _conversations.FirstOrDefault(c => c.Id == message.ConversationId);
        if (conv != null && conv.LastMessage?.Id == message.Id)
        {
            conv.LastMessage.Content = message.Content;
            conv.LastMessage.UpdatedAt = message.UpdatedAt;
            Console.WriteLine($"[Chat] OnMessageEditedEvent: updated lastMessage in conversation list");
            StateHasChanged();
        }
    }

    private void OnMessageReceived(MessageResponse message)
    {
        if (_selectedConversation != null && message.ConversationId == _selectedConversation.Id)
        {
            // Добавить сообщение в список
            var dto = new MessageDto
            {
                Id = message.Id,
                ConversationId = message.ConversationId,
                SenderId = message.SenderId,
                SenderName = message.SenderName,
                Content = message.Content,
                ImageUrl = message.ImageUrl,
                CreatedAt = message.CreatedAt,
                UpdatedAt = message.UpdatedAt
            };
            _messages.Add(dto);
            StateHasChanged();
        }

        // Обновить последнее сообщение в списке диалогов
        var conv = _conversations.FirstOrDefault(c => c.Id == message.ConversationId);
        if (conv != null)
        {
            conv.LastMessage = new MessageDto
            {
                Id = message.Id,
                ConversationId = message.ConversationId,
                SenderId = message.SenderId,
                SenderName = message.SenderName,
                Content = message.Content,
                CreatedAt = message.CreatedAt,
                UpdatedAt = message.UpdatedAt
            };
        }

        // Переместить диалог наверх
        _conversations.Remove(conv!);
        _conversations.Insert(0, conv!);
        StateHasChanged();
    }

    private void OnUserTypingEvent(int conversationId, int userId, string userName)
    {
        if (_selectedConversation?.Id == conversationId)
        {
            _typingUserIds.Add(userId);
            _typingUsers = userName;
            StateHasChanged();

            // Убрать индикатор через 3 секунды
            _ = Task.Run(async () =>
            {
                await Task.Delay(3000);
                _typingUserIds.Remove(userId);
                _typingUsers = _typingUserIds.Count > 0
                    ? _conversations
                        .SelectMany(c => c.Participants)
                        .FirstOrDefault(p => p.UserId == _typingUserIds.FirstOrDefault())?.FullName
                    : null;
                InvokeAsync(StateHasChanged);
            });
        }
    }

    private void OnMessageDeletedEvent(int messageId, int conversationId)
    {
        if (_selectedConversation?.Id == conversationId)
        {
            _messages.RemoveAll(m => m.Id == messageId);
            StateHasChanged();
        }

        // Если сообщение редактировалось, закрыть режим редактирования
        if (_editingMessageId.HasValue && _editingMessageId == messageId)
        {
            CancelEditMessage();
        }
    }

    private void OnConversationCreatedEvent(ConversationCreatedDto conv)
    {
        _ = LoadConversationsAsync();
    }

    private void ShowNewChatModal()
    {
        _showNewChatModal = true;
        _searchLogin = "";
        _searchResult = null;
        _searchError = null;
        _selectedUserIds.Clear();
        _newConversationType = "Direct";
    }

    private async Task SearchUser()
    {
        if (string.IsNullOrWhiteSpace(_searchLogin))
        {
            _searchError = "Введите логин";
            return;
        }

        _searchResult = await ChatService.SearchUserAsync(_searchLogin.Trim());
        if (_searchResult == null)
        {
            _searchError = "Пользователь не найден";
        }
        else
        {
            _searchError = null;
        }
    }

    private void ToggleUserSelection(int userId)
    {
        if (_selectedUserIds.Contains(userId))
            _selectedUserIds.Remove(userId);
        else
            _selectedUserIds.Add(userId);
    }

    private void HandleSearchKeyDown(KeyboardEventArgs args)
    {
        if (args.Key == "Enter")
        {
            SearchUser();
        }
    }

    private async Task CreateConversation()
    {
        if (_currentUser == null)
            return;

        if (_newConversationType != "Channel" && _selectedUserIds.Count == 0)
            return;

        var dto = new CreateConversationDto
        {
            ParticipantIds = _selectedUserIds.ToList(),
            ConversationTypeName = _newConversationType
        };

        var result = await ChatService.CreateConversationAsync(dto);
        if (result != null)
        {
            _showNewChatModal = false;
            _conversations.Insert(0, result);
            await SelectConversation(result);
        }
    }

    private string GetActiveClass(bool isActive)
    {
        return isActive ? "active" : "";
    }

    private string FormatTime(DateTime time)
    {
        var localTime = time.ToLocalTime();
        if (localTime.Date == DateTime.Today)
            return localTime.ToString("HH:mm");
        if (localTime.Date == DateTime.Today.AddDays(-1))
            return "Вчера";
        return localTime.ToString("dd.MM.yyyy");
    }

    // Методы для меню чатов
    private void OpenGroupSettings(ConversationDto conv)
    {
        _openMenuConversationId = null;
        _groupSettingsConversation = conv;
        _groupSettingsName = conv.ConversationTypeName == "Group" ? $"Группа ({conv.Participants.Count} уч.)" : "";
        _groupSettingsParticipants = conv.Participants.ToList();
        _showGroupSettingsModal = true;
        _addParticipantLogin = "";
        _addSearchResult = null;
    }

    private void ShowDeleteConfirm(ConversationDto conv)
    {
        _openMenuConversationId = null;
        _deleteConversation = conv;
        _showDeleteConfirmModal = true;
    }

    // Методы для добавления участника
    private void OpenAddParticipantModal()
    {
        _showAddParticipantModal = true;
        _addParticipantLoginNew = "";
        _addParticipantSearchResult = null;
        _addParticipantError = null;
    }

    private async Task SearchUserForAdd()
    {
        if (string.IsNullOrWhiteSpace(_addParticipantLoginNew))
        {
            _addParticipantError = "Введите логин";
            return;
        }

        var user = await ChatService.SearchUserAsync(_addParticipantLoginNew.Trim());
        if (user == null)
        {
            _addParticipantError = "Пользователь не найден";
            _addParticipantSearchResult = null;
        }
        else
        {
            // Проверяем, что пользователь ещё не участник
            if (_selectedConversation != null && _selectedConversation.Participants.Any(p => p.UserId == user.Id))
            {
                _addParticipantError = "Пользователь уже является участником";
                _addParticipantSearchResult = null;
            }
            else
            {
                _addParticipantError = null;
                _addParticipantSearchResult = user;
            }
        }
    }

    private void HandleAddParticipantKeyDown(KeyboardEventArgs args)
    {
        if (args.Key == "Enter")
        {
            SearchUserForAdd();
        }
    }

    private async Task AddParticipant(int userId)
    {
        if (_selectedConversation == null)
            return;

        var result = await ChatService.AddParticipantsAsync(_selectedConversation.Id, new List<int> { userId });
        if (result != null)
        {
            // Обновляем выбранный чат
            _selectedConversation = result;
            // Перезагружаем список чатов
            await LoadConversationsAsync();
            _showAddParticipantModal = false;
        }
        else
        {
            _addParticipantError = "Не удалось добавить участника";
        }
    }

    private async Task RemoveParticipantAsync(int userId)
    {
        if (_selectedConversation == null)
            return;

        var success = await ChatService.RemoveParticipantAsync(_selectedConversation.Id, userId);
        if (success)
        {
            // Обновляем список чатов и восстанавливаем выбранный
            var convId = _selectedConversation.Id;
            await LoadConversationsAsync();
            _selectedConversation = _conversations.FirstOrDefault(c => c.Id == convId);
            if (_selectedConversation != null)
            {
                _messages = await ChatService.GetMessagesAsync(_selectedConversation.Id);
            }
        }
    }

    private async Task SearchUserForGroup()
    {
        if (string.IsNullOrWhiteSpace(_addParticipantLogin))
        {
            return;
        }

        _addSearchResult = await ChatService.SearchUserAsync(_addParticipantLogin.Trim());
        if (_addSearchResult == null)
        {
            // Не показываем ошибку, просто ничего не найдено
        }
    }

    private void AddParticipantToGroup(int userId)
    {
        if (_groupSettingsParticipants != null && !_groupSettingsParticipants.Any(p => p.UserId == userId))
        {
            _groupSettingsParticipants.Add(new ParticipantDto
            {
                UserId = _addSearchResult!.Id,
                FullName = _addSearchResult.FullName,
                Login = _addSearchResult.Login,
                RoleName = "Member"
            });
            _addParticipantLogin = "";
            _addSearchResult = null;
        }
    }

    private void RemoveParticipant(int userId)
    {
        if (_groupSettingsParticipants != null)
        {
            // Не даем удалить самого себя
            if (userId == _currentUser?.Id)
            {
                return;
            }

            _groupSettingsParticipants.RemoveAll(p => p.UserId == userId);
        }
    }

    private async Task SaveGroupSettings()
    {
        if (_groupSettingsConversation == null)
            return;

        // TODO: Реализовать сохранение изменений через API
        // Пока просто закрываем модалку и обновляем список
        _showGroupSettingsModal = false;
        await LoadConversationsAsync();
    }

    private async Task DeleteConversation()
    {
        if (_deleteConversation == null)
            return;

        // Вызываем API для удаления
        var success = await ChatService.DeleteConversationAsync(_deleteConversation.Id);

        if (success)
        {
            // Удаляем из локального списка
            _conversations.RemoveAll(c => c.Id == _deleteConversation.Id);

            // Если удалённый чат был выбран — сбрасываем
            if (_selectedConversation?.Id == _deleteConversation.Id)
            {
                _selectedConversation = null;
                _messages.Clear();
            }
        }
        else
        {
            // Можно показать ошибку
            Console.WriteLine("Failed to delete conversation");
        }

        _showDeleteConfirmModal = false;
        StateHasChanged();
    }

    private async Task LoadCommentsPreview(int messageId)
    {
        var count = await ChatService.GetCommentsCountAsync(messageId);
        _commentsCounts[messageId] = count;
        _commentsPreviews[messageId] = await ChatService.GetCommentsPreviewAsync(messageId);
    }

    private async Task OpenCommentsModal(int messageId)
    {
        _commentsModalMessageId = messageId;
        var conv = await ChatService.GetOrCreateCommentsAsync(messageId);
        if (conv != null)
        {
            _commentsConversation = conv;
            _commentsMessages = await ChatService.GetMessagesAsync(conv.Id);
        }
        _showCommentsModal = true;
    }

    private async Task SendComment()
    {
        if (_commentsConversation == null || string.IsNullOrWhiteSpace(_newCommentText)) return;
        await ChatHub.SendMessageAsync(_commentsConversation.Id, _newCommentText.Trim());
        _newCommentText = "";
        // Refresh messages
        _commentsMessages = await ChatService.GetMessagesAsync(_commentsConversation.Id);
        await LoadCommentsPreview(_commentsModalMessageId);
        StateHasChanged();
    }

    private void HandleCommentKeyDown(KeyboardEventArgs args)
    {
        if (args.Key == "Enter" && !string.IsNullOrWhiteSpace(_newCommentText))
        {
            SendComment();
        }
    }

    public void Dispose()
    {
        ChatHub.OnMessageReceived -= OnMessageReceived;
        ChatHub.OnUserTyping -= OnUserTypingEvent;
        ChatHub.OnMessageDeleted -= OnMessageDeletedEvent;
        ChatHub.OnMessageEdited -= OnMessageEditedEvent;
        ChatHub.OnConversationCreated -= OnConversationCreatedEvent;
    }

    // ! GetConversationDisplayName - returns display name based on conversation type
    private string GetConversationDisplayName(ConversationDto conv)
    {
        return conv.ConversationTypeName switch
        {
            "Direct" => string.Join(", ", conv.Participants
                .Where(p => p.UserId != _currentUser?.Id)
                .Select(p => p.FullName)),
            "Group" => $"Группа ({conv.Participants.Count} уч.)",
            "Channel" => $"Канал: {string.Join(", ", conv.Participants.Take(1).Select(p => p.FullName))}",
            "Comments" => $"Комментарии ({conv.Participants.Count} уч.)",
            _ => $"Чат ({conv.Participants.Count} уч.)"
        };
    }

    // ! GetConversationIcon - returns Bootstrap icon based on conversation type
    private string GetConversationIcon(string typeName)
    {
        return typeName switch
        {
            "Direct" => "<i class=\"bi bi-chat-dots-fill text-primary me-1\"></i>",
            "Group" => "<i class=\"bi bi-people-fill text-success me-1\"></i>",
            "Channel" => "<i class=\"bi bi-megaphone-fill text-warning me-1\"></i>",
            "Comments" => "<i class=\"bi bi-chat-quote-fill text-info me-1\"></i>",
            _ => "<i class=\"bi bi-chat-fill me-1\"></i>"
        };
    }

    // ! GetRoleBadgeClass - returns Bootstrap badge class based on role
    private string GetRoleBadgeClass(string roleName)
    {
        return roleName switch
        {
            "Owner" => "bg-danger",
            "Admin" => "bg-warning text-dark",
            "Moderator" => "bg-info",
            "Member" => "bg-secondary",
            _ => "bg-secondary"
        };
    }

    private bool CanSendMessage()
    {
        if (_selectedConversation == null || _currentUser == null) return false;
        var myRole = _selectedConversation.Participants.FirstOrDefault(p => p.UserId == _currentUser.Id)?.RoleName;
        if (myRole == null) return false;
        if (myRole == "Member" && _selectedConversation.ConversationTypeName == "Channel") return false;
        return true;
    }

    private bool CanDeleteOwnMessage()
    {
        if (_selectedConversation == null || _currentUser == null) return false;
        var myRole = _selectedConversation.Participants.FirstOrDefault(p => p.UserId == _currentUser.Id)?.RoleName;
        if (myRole == null) return false;
        if (myRole == "Member" && _selectedConversation.ConversationTypeName == "Channel") return false;
        return true;
    }

    private bool CanDeleteOtherMessage()
    {
        if (_selectedConversation == null || _currentUser == null) return false;
        var myRole = _selectedConversation.Participants.FirstOrDefault(p => p.UserId == _currentUser.Id)?.RoleName;
        return myRole is "Owner" or "Moderator";
    }

    private bool CanEditOwnMessage()
    {
        if (_selectedConversation == null || _currentUser == null) return false;
        var myRole = _selectedConversation.Participants.FirstOrDefault(p => p.UserId == _currentUser.Id)?.RoleName;
        if (myRole == null) return false;
        if (myRole == "Member" && _selectedConversation.ConversationTypeName == "Channel") return false;
        return true;
    }

    private bool IsOwner()
    {
        if (_selectedConversation == null || _currentUser == null) return false;
        var myRole = _selectedConversation.Participants.FirstOrDefault(p => p.UserId == _currentUser.Id)?.RoleName;
        return myRole == "Owner";
    }

    private bool CanManageParticipants()
    {
        if (_selectedConversation == null || _currentUser == null) return false;
        var myRole = _selectedConversation.Participants.FirstOrDefault(p => p.UserId == _currentUser.Id)?.RoleName;
        return myRole is "Owner" or "Moderator";
    }

    private bool CanTransferOwnership()
    {
        if (_selectedConversation == null || _currentUser == null) return false;
        if (_selectedConversation.ConversationTypeName == "Direct") return false;
        return IsOwner();
    }

    private async Task TransferOwnership(int newOwnerId)
    {
        if (_selectedConversation == null) return;
        var success = await ChatService.TransferOwnershipAsync(_selectedConversation.Id, newOwnerId);
        if (success)
        {
            _showTransferOwnershipModal = false;
            await LoadConversationsAsync();
            if (_selectedConversation != null)
            {
                _selectedConversation = _conversations.FirstOrDefault(c => c.Id == _selectedConversation.Id);
            }
        }
    }

    private void OpenChangeRoleModal(ParticipantDto participant)
    {
        _changeRoleParticipant = participant;
        _showChangeRoleModal = true;
    }

    private void CloseChangeRoleModal()
    {
        _showChangeRoleModal = false;
        _changeRoleParticipant = null;
    }

    private async Task ChangeRole(string newRole)
    {
        if (_selectedConversation == null || _changeRoleParticipant == null) return;

        var success = await ChatService.ChangeRoleAsync(_selectedConversation.Id, _changeRoleParticipant.UserId, newRole);
        if (success)
        {
            CloseChangeRoleModal();
            await LoadConversationsAsync();
            if (_selectedConversation != null)
            {
                _selectedConversation = _conversations.FirstOrDefault(c => c.Id == _selectedConversation.Id);
            }
        }
    }

    private string GetRoleDisplayName(string roleName)
    {
        return roleName switch
        {
            "Owner" => "Владелец",
            "Moderator" => "Модератор",
            "Member" => "Участник",
            _ => roleName
        };
    }

