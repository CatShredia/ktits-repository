@page "/profile"
@layout MainLayout
@inject IAuthService AuthService
@inject NavigationManager Navigation

<PageTitle>Профиль - CinemaBlazor</PageTitle>

<AuthorizeView>
    <Authorized>
        <div class="row justify-content-center">
            <div class="col-md-8 col-lg-6">
                <div class="card shadow">
                    <div class="card-header bg-primary text-white">
                        <h4 class="mb-0">Мой профиль</h4>
                    </div>
                    <div class="card-body">
                        @if (user != null)
                        {
                            <div class="mb-3">
                                <label class="form-label fw-bold">ФИО</label>
                                <p class="form-control-plaintext">@user.Surname @user.Name</p>
                            </div>
                            <div class="mb-3">
                                <label class="form-label fw-bold">Email</label>
                                <p class="form-control-plaintext">@user.Email</p>
                            </div>
                            <div class="mb-3">
                                <label class="form-label fw-bold">Пол</label>
                                <p class="form-control-plaintext">@(user.Gender == "Male" ? "Мужской" : user.Gender == "Female" ? "Женский" : user.Gender)</p>
                            </div>
                            @if (!string.IsNullOrEmpty(user.Description))
                            {
                                <div class="mb-3">
                                    <label class="form-label fw-bold">О себе</label>
                                    <p class="form-control-plaintext">@user.Description</p>
                                </div>
                            }
                            <div class="mb-3">
                                <label class="form-label fw-bold">Роль</label>
                                <p class="form-control-plaintext">
                                    <span class="badge @(_isAdmin ? "bg-danger" : "bg-info")">
                                        @(_isAdmin ? "Администратор" : "Пользователь")
                                    </span>
                                </p>
                            </div>
                        }
                        else
                        {
                            <div class="alert alert-info">Загрузка профиля...</div>
                        }
                    </div>
                    <div class="card-footer">
                        <a href="profile/edit" class="btn btn-primary">Изменить профиль</a>
                    </div>
                </div>
            </div>
        </div>
    </Authorized>
    <NotAuthorized>
        <div class="alert alert-warning">
            Пожалуйста, <a href="login">войдите</a>, чтобы просматривать свой профиль.
        </div>
    </NotAuthorized>
</AuthorizeView>

@code {
    private UserResponseDto? user;
    private bool _isAdmin = false;

    protected override async Task OnInitializedAsync()
    {
        if (await AuthService.IsAuthenticatedAsync())
        {
            user = await AuthService.GetCurrentUserAsync();
            _isAdmin = await AuthService.IsInRoleAsync("admin");
        }
    }
}
