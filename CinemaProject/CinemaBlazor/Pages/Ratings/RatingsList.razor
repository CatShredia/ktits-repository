@page "/ratings"
@layout MainLayout
@inject IRatingService RatingService
@inject IFilmService FilmService
@inject IAuthService AuthService
@inject IJSRuntime JSRuntime

<PageTitle>Оценки - CinemaBlazor</PageTitle>

<AuthorizeView>
    <Authorized>
        <h3>⭐ Оценки</h3>

        @if (isLoading)
        {
            <div class="text-center py-5">
                <div class="spinner-border text-primary" role="status">
                    <span class="visually-hidden">Загрузка...</span>
                </div>
            </div>
        }
        else if (ratings.Count == 0)
        {
            <div class="alert alert-info">
                Оценок не найдено. Начните оценивать фильмы в разделе <a href="films">Фильмы</a>!
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover">
                    <thead class="table-dark">
                        <tr>
                            <th>Фильм</th>
                            <th>Ваша оценка</th>
                            <th>Автор</th>
                            @if (_isAdmin)
                            {
                                <th>Действия</th>
                            }
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var rating in ratings)
                        {
                            <tr>
                                <td>
                                    <a href="films/@rating.FilmId">@rating.FilmName</a>
                                </td>
                                <td>
                                    <span class="badge bg-warning text-dark">⭐ @rating.Value/10</span>
                                </td>
                                <td>@(rating.AuthorName ?? "Аноним")</td>
                                @if (_isAdmin)
                                {
                                    <td>
                                        <button class="btn btn-sm btn-outline-danger" @onclick="() => DeleteRating(rating.Id)">
                                            Удалить
                                        </button>
                                    </td>
                                }
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </Authorized>
    <NotAuthorized>
        <div class="alert alert-warning">
            Пожалуйста, <a href="login">войдите</a>, чтобы просматривать оценки.
        </div>
    </NotAuthorized>
</AuthorizeView>

@code {
    private List<RatingResponseDto> ratings = new();
    private bool isLoading;
    private bool _isAdmin = false;

    protected override async Task OnInitializedAsync()
    {
        if (await AuthService.IsAuthenticatedAsync())
        {
            _isAdmin = await AuthService.IsInRoleAsync("admin");
            isLoading = true;
            ratings = await RatingService.GetAllRatingsAsync();
            isLoading = false;
        }
    }

    private async Task DeleteRating(int id)
    {
        if (await JSRuntime.InvokeAsync<bool>("eval", "confirm('Are you sure you want to delete this rating?')"))
        {
            var success = await RatingService.DeleteRatingAsync(id);
            if (success)
            {
                ratings = await RatingService.GetAllRatingsAsync();
            }
        }
    }
}