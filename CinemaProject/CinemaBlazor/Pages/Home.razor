@page "/"
@layout MainLayout
@inject IFilmService FilmService

<PageTitle>Home - CinemaBlazor</PageTitle>

<div class="text-center py-5">
    <h1 class="display-4">🎬 Welcome to CinemaBlazor</h1>
    <p class="lead">Your favorite place to discover and manage films</p>
    <hr class="my-4" />
    <p>Explore our collection of films, rate your favorites, and discover new classics!</p>
    <a href="films" class="btn btn-primary btn-lg me-2">Browse Films</a>
</div>

@if (isLoading)
{
    <div class="text-center py-5">
        <div class="spinner-border text-primary" role="status">
            <span class="visually-hidden">Loading...</span>
        </div>
    </div>
}
else if (featuredFilms.Count > 0)
{
    <h3 class="mb-4">Featured Films</h3>
    <div class="row row-cols-1 row-cols-md-3 g-4">
        @foreach (var film in featuredFilms.Take(3))
        {
            <div class="col">
                <div class="card h-100 shadow-sm">
                    @if (!string.IsNullOrEmpty(film.ImageUrl))
                    {
                        <img src="@film.ImageUrl" class="card-img-top" alt="@film.Name" style="height: 200px; object-fit: cover;" />
                    }
                    else
                    {
                        <div class="bg-secondary text-white d-flex align-items-center justify-content-center"
                             style="height: 200px;">
                            <span class="bi bi-film" style="font-size: 3rem;"></span>
                        </div>
                    }
                    <div class="card-body">
                        <h5 class="card-title">@film.Name</h5>
                        <p class="card-text text-muted small">
                            @if (film.Genre != null)
                            {
                                <span class="badge bg-secondary me-1">@film.Genre.Name</span>
                            }
                        </p>
                        <a href="films/@film.Id" class="btn btn-outline-primary">View Details</a>
                    </div>
                </div>
            </div>
        }
    </div>
    <div class="text-center mt-4">
        <a href="films" class="btn btn-link">View all films →</a>
    </div>
}

@code {
    private List<Film> featuredFilms = new();
    private bool isLoading = true;
    private bool IsAuthenticated = false;

    protected override async Task OnInitializedAsync()
    {
        featuredFilms = await FilmService.GetAllFilmsAsync("rating_desc");
        isLoading = false;
    }
}