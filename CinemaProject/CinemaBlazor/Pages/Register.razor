@page "/register"
@layout MainLayout
@inject IAuthService AuthService
@inject NavigationManager Navigation

<PageTitle>Регистрация - CinemaBlazor</PageTitle>

<div class="row justify-content-center">
    <div class="col-md-8 col-lg-6">
        <div class="card shadow">
            <div class="card-header bg-success text-white">
                <h4 class="mb-0">Регистрация</h4>
            </div>
            <div class="card-body">
                <EditForm Model="@registerDto" OnValidSubmit="HandleRegister">
                    <DataAnnotationsValidator />

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Фамилия *</label>
                            <InputText @bind-Value="registerDto.Surname" class="form-control" placeholder="Фамилия" />
                            <ValidationMessage For="@(() => registerDto.Surname)" />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Имя *</label>
                            <InputText @bind-Value="registerDto.Name" class="form-control" placeholder="Имя" />
                            <ValidationMessage For="@(() => registerDto.Name)" />
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">О себе</label>
                        <InputTextArea @bind-Value="registerDto.Description" class="form-control" rows="2"
                                       placeholder="Расскажите о себе" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Пол *</label>
                        <InputSelect @bind-Value="registerDto.Gender" class="form-select">
                            <option value="">Выберите пол</option>
                            <option value="Male">Мужской</option>
                            <option value="Female">Женский</option>
                            <option value="Other">Другой</option>
                        </InputSelect>
                        <ValidationMessage For="@(() => registerDto.Gender)" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Email *</label>
                        <InputText @bind-Value="registerDto.Email" class="form-control" type="email"
                                   placeholder="email@example.com" />
                        <ValidationMessage For="@(() => registerDto.Email)" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Логин *</label>
                        <InputText @bind-Value="registerDto.Login" class="form-control"
                                   placeholder="Придумайте логин" />
                        <ValidationMessage For="@(() => registerDto.Login)" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Пароль *</label>
                        <InputText @bind-Value="registerDto.Password" class="form-control" type="password"
                                   placeholder="Минимум 6 символов" />
                        <ValidationMessage For="@(() => registerDto.Password)" />
                    </div>

                    @if (!string.IsNullOrEmpty(errorMessage))
                    {
                        <div class="alert alert-danger">@errorMessage</div>
                    }

                    <button type="submit" class="btn btn-success w-100" disabled="@isLoading">
                        @if (isLoading)
                        {
                            <span class="spinner-border spinner-border-sm me-2"></span>
                        }
                        Зарегистрироваться
                    </button>
                </EditForm>
            </div>
            <div class="card-footer text-center">
                <small>Уже есть аккаунт? <a href="login">Войти</a></small>
            </div>
        </div>
    </div>
</div>

@code {
    private UserRegisterDto registerDto = new();
    private string? errorMessage;
    private bool isLoading;

    private async Task HandleRegister()
    {
        isLoading = true;
        errorMessage = null;

        var result = await AuthService.RegisterAsync(registerDto);

        if (result != null)
        {
            Navigation.NavigateTo("/films");
        }
        else
        {
            errorMessage = "Ошибка регистрации. Возможно, логин или email уже заняты.";
        }

        isLoading = false;
    }
}