@page "/genres"
@layout MainLayout
@inject IGenreService GenreService
@inject IAuthService AuthService
@inject IJSRuntime JSRuntime

<PageTitle>Жанры - CinemaBlazor</PageTitle>

<h3>📁 Жанры</h3>

@if (_isAdmin)
{
    <a href="genres/create" class="btn btn-primary mb-3">
        <span class="bi bi-plus-circle"></span> Создать жанр
    </a>
}

@if (isLoading)
{
    <div class="text-center py-5">
        <div class="spinner-border text-primary" role="status">
            <span class="visually-hidden">Загрузка...</span>
        </div>
    </div>
}
else if (genres.Count == 0)
{
    <div class="alert alert-info">Жанры не найдены.</div>
}
else
{
    <div class="table-responsive">
        <table class="table table-hover">
            <thead class="table-dark">
                <tr>
                    <th>ID</th>
                    <th>Название</th>
                    <th>Описание</th>
                    @if (_isAdmin)
                    {
                        <th>Действия</th>
                    }
                </tr>
            </thead>
            <tbody>
                @foreach (var genre in genres)
                {
                    <tr>
                        <td>@genre.Id</td>
                        <td>@genre.Name</td>
                        <td>@(genre.Description ?? "Нет описания")</td>
                        @if (_isAdmin)
                        {
                            <td>
                                <a href="genres/@genre.Id/edit" class="btn btn-sm btn-outline-primary">Изменить</a>
                                <button class="btn btn-sm btn-outline-danger ms-1"
                                        @onclick="() => DeleteGenre(genre.Id)">Удалить</button>
                            </td>
                        }
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@code {
    private List<Genre> genres = new();
    private bool isLoading;
    private bool _isAdmin = false;

    protected override async Task OnInitializedAsync()
    {
        _isAdmin = await AuthService.IsInRoleAsync("admin");
        isLoading = true;
        genres = await GenreService.GetAllGenresAsync();
        isLoading = false;
    }

    private async Task DeleteGenre(int id)
    {
        if (await JSRuntime.InvokeAsync<bool>("eval", "confirm('Are you sure you want to delete this genre?')"))
        {
            var success = await GenreService.DeleteGenreAsync(id);
            if (success)
            {
                genres = await GenreService.GetAllGenresAsync();
            }
        }
    }
}