@page "/genres/create"
@layout MainLayout
@inject IGenreService GenreService
@inject NavigationManager Navigation
@inject IAuthService AuthService

<PageTitle>Создать жанр - CinemaBlazor</PageTitle>

<AuthorizeView Roles="admin">
    <Authorized>
        <h3>📁 Создать новый жанр</h3>

        <div class="card">
            <div class="card-body">
                <EditForm Model="@genre" OnValidSubmit="HandleCreate" Context="EditContext">
                    <DataAnnotationsValidator />

                    <div class="mb-3">
                        <label class="form-label">Название жанра *</label>
                        <InputText @bind-Value="genre.Name" class="form-control" placeholder="Введите название жанра" />
                        <ValidationMessage For="@(() => genre.Name)" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Описание</label>
                        <InputTextArea @bind-Value="genre.Description" class="form-control" rows="4"
                                       placeholder="Описание жанра" />
                    </div>

                    @if (!string.IsNullOrEmpty(errorMessage))
                    {
                        <div class="alert alert-danger">@errorMessage</div>
                    }

                    <button type="submit" class="btn btn-primary" disabled="@isLoading">
                        @if (isLoading)
                        {
                            <span class="spinner-border spinner-border-sm me-2"></span>
                        }
                        Создать жанр
                    </button>
                    <a href="genres" class="btn btn-outline-secondary ms-2">Отмена</a>
                </EditForm>
            </div>
        </div>
    </Authorized>
    <NotAuthorized>
        <div class="alert alert-warning">Вы должны быть администратором для создания жанров.</div>
    </NotAuthorized>
</AuthorizeView>

@code {
    private Genre genre = new();
    private string? errorMessage;
    private bool isLoading;
    private bool _isAdmin = false;

    protected override async Task OnInitializedAsync()
    {
        _isAdmin = await AuthService.IsInRoleAsync("admin");
    }

    private async Task HandleCreate()
    {
        isLoading = true;
        errorMessage = null;

        var result = await GenreService.CreateGenreAsync(genre);

        if (result != null)
        {
            Navigation.NavigateTo("/genres");
        }
        else
        {
            errorMessage = "Failed to create genre. Please try again.";
        }

        isLoading = false;
    }
}