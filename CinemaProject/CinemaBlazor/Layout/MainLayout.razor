@inherits LayoutComponentBase
@using Microsoft.AspNetCore.Components.Authorization
@inject AuthenticationStateProvider AuthenticationStateProvider

<div class="page">
    <div class="sidebar">
        <NavMenu />
    </div>
    
    <main>
        <div class="top-row px-4">
            <AuthorizeView>
                <Authorized>
                    @if (!string.IsNullOrEmpty(_userName))
                    {
                        <span class="me-3">Привет, @_userName!</span>
                    }
                    <a href="profile" class="me-2">Профиль</a>
                    <a href="logout" class="btn btn-link">Выход</a>
                </Authorized>
                <NotAuthorized>
                    <a href="login" class="me-2">Вход</a>
                    <a href="register">Регистрация</a>
                </NotAuthorized>
            </AuthorizeView>
        </div>

        <article class="content px-4">
            @Body
        </article>

        <footer class="border-top mt-5 py-4 bg-light">
            <div class="container">
                <div class="row">
                    <div class="col-md-4 text-center text-md-start">
                        <h5>CinemaBlazor</h5>
                        <p class="text-muted small">Ваше любимое место для просмотра и управления фильмами</p>
                    </div>
                    <div class="col-md-4 text-center">
                        <h6>Быстрые ссылки</h6>
                        <ul class="list-unstyled">
                            <li><a href="films" class="text-decoration-none">Фильмы</a></li>
                            <li><a href="genres" class="text-decoration-none">Жанры</a></li>
                            <li><a href="ratings" class="text-decoration-none">Оценки</a></li>
                        </ul>
                    </div>
                </div>
            </div>
        </footer>
    </main>
</div>

@code {
    [CascadingParameter]
    private Task<AuthenticationState> AuthenticationStateTask { get; set; } = default!;

    private string? _userName;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthenticationStateTask;
        var user = authState.User;
        
        var nameClaim = user.FindFirst(c => c.Type == "name")?.Value;
        var surnameClaim = user.FindFirst(c => c.Type == "surname")?.Value;
        
        if (!string.IsNullOrEmpty(nameClaim) && !string.IsNullOrEmpty(surnameClaim))
            _userName = $"{nameClaim} {surnameClaim}";
        else
            _userName = user.Identity?.Name ?? "User";
    }
}
