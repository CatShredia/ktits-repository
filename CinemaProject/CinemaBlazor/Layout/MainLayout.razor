@inherits LayoutComponentBase
@inject IAuthService AuthService

<div class="page">
    <div class="sidebar">
        <NavMenu />
    </div>

    <main>
        <div class="top-row px-4">
            @if (_isAuthenticated)
            {
                <span class="me-3">Welcome, @GetUserName()!</span>
                <a href="profile" class="me-2">Profile</a>
                <a href="logout" class="btn btn-link">Logout</a>
            }
            else
            {
                <a href="login" class="me-2">Login</a>
                <a href="register">Register</a>
            }
        </div>

        <article class="content px-4">
            @Body
        </article>
    </main>
</div>

@code {
    private bool _isAuthenticated = false;
    private UserResponseDto? _currentUser;

    protected override async Task OnInitializedAsync()
    {
        _isAuthenticated = await AuthService.IsAuthenticatedAsync();
        _currentUser = await AuthService.GetCurrentUserAsync();
    }

    private string GetUserName()
    {
        return _currentUser != null ? $"{_currentUser.Name} {_currentUser.Surname}" : "User";
    }
}
