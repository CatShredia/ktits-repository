@using CinemaBlazor.Services

@if (HasImage)
{
    <img src="@ImageUrl" class="@CssClass" style="@Style" alt="@AltText" @attributes="AdditionalAttributes" />
}
else
{
    <div class="@PlaceholderCssClass" style="@PlaceholderStyle" @attributes="AdditionalAttributes">
        <span class="bi bi-film" style="font-size: 3rem;"></span>
    </div>
}

@code {
    /// <summary>
    /// URL изображения (полный или относительный)
    /// </summary>
    [Parameter]
    public string? ImageUrl { get; set; }

    /// <summary>
    /// Базовый URL API для локальных изображений
    /// </summary>
    [Parameter]
    public string? ApiBaseUrl { get; set; } = "http://localhost:5268";

    /// <summary>
    /// CSS класс для изображения
    /// </summary>
    [Parameter]
    public string? Class { get; set; }

    /// <summary>
    /// Дополнительный CSS класс для placeholder
    /// </summary>
    [Parameter]
    public string? PlaceholderClass { get; set; }

    /// <summary>
    /// Inline стили для изображения
    /// </summary>
    [Parameter]
    public string? Style { get; set; }

    /// <summary>
    /// Inline стили для placeholder
    /// </summary>
    [Parameter]
    public string? PlaceholderStyle { get; set; }

    /// <summary>
    /// Альтернативный текст для изображения
    /// </summary>
    [Parameter]
    public string? Alt { get; set; }

    /// <summary>
    /// Дополнительные атрибуты
    /// </summary>
    [Parameter(CaptureUnmatchedValues = true)]
    public IDictionary<string, object> AdditionalAttributes { get; set; } = new Dictionary<string, object>();

    private string? AltText => Alt ?? "Film poster";

    private bool HasImage => !string.IsNullOrEmpty(ImageUrl);

    private string? ImageUrlResolved
    {
        get
        {
            if (string.IsNullOrEmpty(ImageUrl))
                return null;

            // Если URL начинается с "/", это локальное изображение на API сервере
            if (ImageUrl.StartsWith("/"))
            {
                return $"{ApiBaseUrl?.TrimEnd('/')}{ImageUrl}";
            }

            // Иначе это внешний URL
            return ImageUrl;
        }
    }

    private string CssClass => $"card-img-top {Class ?? ""}";

    private string PlaceholderCssClass => $"bg-secondary text-white d-flex align-items-center justify-content-center card-img-top {PlaceholderClass ?? ""}";
}
