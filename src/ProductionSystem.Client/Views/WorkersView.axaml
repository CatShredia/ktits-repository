<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ProductionSystem.Client.ViewModels"
             x:Class="ProductionSystem.Client.Views.WorkersView"
             x:DataType="vm:WorkersViewModel">
    <Grid ColumnDefinitions="320,*">
        <DockPanel Margin="0,0,12,0">
            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="8" Margin="0,0,0,8">
                <Button Content="Обновить список" Command="{Binding RefreshWorkersCommand}" />
                <Button Content="Новый" Command="{Binding StartNewCommand}" />
            </StackPanel>

            <ListBox ItemsSource="{Binding Workers}" SelectedItem="{Binding SelectedWorker}">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="4">
                            <TextBlock Text="{Binding LastName}" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding Age, StringFormat='Возраст: {0}'}" />
                            <TextBlock Text="{Binding OperationsCommaSeparated}" TextWrapping="Wrap" />
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>

        <ScrollViewer Grid.Column="1">
            <StackPanel Spacing="10">
                <TextBlock Text="Карточка работника" FontSize="18" FontWeight="SemiBold" />

                <TextBox Watermark="Фамилия" Text="{Binding LastName}" />
                <TextBox Watermark="Имя, отчество" Text="{Binding FirstMiddleName}" />
                <DatePicker SelectedDate="{Binding BirthDate}" />
                <TextBox Watermark="Домашний адрес" Text="{Binding HomeAddress}" AcceptsReturn="True" />
                <TextBox Watermark="Образование" Text="{Binding Education}" />
                <TextBox Watermark="Квалификация" Text="{Binding Qualification}" />

                <TextBlock Text="Операции" FontWeight="SemiBold" />
                <ItemsControl ItemsSource="{Binding Operations}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:OperationPickVm">
                            <CheckBox Content="{Binding Name}" IsChecked="{Binding IsSelected, Mode=TwoWay}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBox Width="260" Watermark="Новая операция" Text="{Binding NewOperationName}" />
                    <Button Content="Добавить операцию" Command="{Binding AddOperationCommand}" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Content="Сохранить" Command="{Binding SaveCommand}" />
                    <Button Content="Удалить" Command="{Binding DeleteCommand}" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
