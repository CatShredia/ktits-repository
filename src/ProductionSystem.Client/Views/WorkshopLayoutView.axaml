<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ProductionSystem.Client.ViewModels"
             x:Class="ProductionSystem.Client.Views.WorkshopLayoutView"
             x:DataType="vm:WorkshopLayoutViewModel">
    <Grid ColumnDefinitions="160,*" RowDefinitions="Auto,*">
        <StackPanel Grid.ColumnSpan="2" Orientation="Horizontal" Spacing="8" Margin="0,0,0,8">
            <TextBlock Text="Цех:" VerticalAlignment="Center" />
            <ComboBox Width="220" ItemsSource="{Binding Workshops}" SelectedItem="{Binding SelectedWorkshop}">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Name}" />
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
            <Button Content="Сохранить" Command="{Binding SaveCommand}" />
            <Button Content="Отменить" Command="{Binding CancelChangesCommand}" />
            <Button Content="+" Command="{Binding ZoomInCommand}" />
            <Button Content="-" Command="{Binding ZoomOutCommand}" />
        </StackPanel>

        <StackPanel Grid.Row="1" Spacing="6">
            <TextBlock Text="Значки" FontWeight="SemiBold" />
            <ListBox ItemsSource="{Binding PaletteIcons}" SelectedItem="{Binding SelectedPaletteIcon}" />
            <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" />
        </StackPanel>

        <Border Grid.Row="1" Grid.Column="1" BorderBrush="#CCC" BorderThickness="1" ClipToBounds="True">
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                <Canvas x:Name="PlanCanvas" Width="800" Height="500"
                        Background="#F8F8F8"
                        PointerPressed="PlanCanvas_PointerPressed" />
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>
