<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:ProductionSystem.Client.ViewModels"
        x:Class="ProductionSystem.Client.Views.RegisterWindow"
        x:DataType="vm:RegisterViewModel"
        Width="520"
        Height="560"
        WindowStartupLocation="CenterOwner"
        Title="Регистрация заказчика">

    <DockPanel>
        <Border DockPanel.Dock="Top" Background="#4867AC" Padding="12">
            <StackPanel Orientation="Horizontal" Spacing="12">
                <Image Width="140" Height="44" Stretch="Uniform"
                       Source="avares://ProductionSystem.Client/Assets/Logo_Color.png" />
                <TextBlock Text="Регистрация заказчика"
                           Foreground="White"
                           VerticalAlignment="Center"
                           FontSize="16"
                           FontWeight="SemiBold" />
            </StackPanel>
        </Border>

        <StackPanel Margin="24" Spacing="10" VerticalAlignment="Top">
            <TextBox Watermark="Логин" Text="{Binding Login}" />
            <TextBox Watermark="Пароль" PasswordChar="*" Text="{Binding Password}" />
            <TextBox Watermark="ФИО" Text="{Binding FullName}" AcceptsReturn="True" />
            <TextBlock Text="{Binding ErrorMessage}" Foreground="#BB0C07" TextWrapping="Wrap" />
            <Button Content="Зарегистрироваться" Command="{Binding RegisterCommand}" HorizontalAlignment="Stretch" />
            <Button Content="Отмена" Command="{Binding CancelCommand}" HorizontalAlignment="Stretch" />
        </StackPanel>
    </DockPanel>
</Window>
