<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="AutoService.AvaloniaApp.Views.LoginView">
  <Grid Background="#F4F7F8">
    <Border Width="420"
            Padding="28"
            CornerRadius="8"
            Background="White"
            BorderBrush="#D5DEE3"
            BorderThickness="1"
            HorizontalAlignment="Center"
            VerticalAlignment="Center">
      <StackPanel Spacing="10">
        <TextBlock Classes="h1" Text="Система управления автосервисом" TextWrapping="Wrap" />
        <TextBlock Classes="hint" Text="Вход для администратора, механика и руководителя" />
        <TextBlock Text="Логин" />
        <TextBox Text="{Binding Login}" Watermark="Логин" />
        <TextBlock Text="Пароль" />
        <TextBox Text="{Binding Password}" PasswordChar="*" Watermark="Пароль" />
        <Button Content="Войти" Command="{Binding SignInCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
        <TextBlock Classes="error" Text="{Binding Error}" IsVisible="{Binding HasError}" />
      </StackPanel>
    </Border>
  </Grid>
</UserControl>
