<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="AutoService.AvaloniaApp.Views.ShellView">
  <Grid ColumnDefinitions="240,*">
    <Border Grid.Column="0" Background="#F7F9FB" BorderBrush="#D5DEE3" BorderThickness="0,0,1,0" Padding="12">
      <DockPanel>
        <StackPanel DockPanel.Dock="Bottom" Spacing="8">
          <TextBlock Text="{Binding UserTitle}" TextWrapping="Wrap" />
          <Button Content="Выйти" Command="{Binding LogoutCommand}" HorizontalAlignment="Stretch" />
        </StackPanel>
        <TextBlock DockPanel.Dock="Top" Text="Разделы" FontWeight="SemiBold" Margin="0,0,0,8" />
        <ListBox ItemsSource="{Binding Menu}" SelectedItem="{Binding SelectedMenu}" />
      </DockPanel>
    </Border>
    <ContentControl Grid.Column="1" Content="{Binding Content}" Margin="16" />
  </Grid>
</UserControl>
