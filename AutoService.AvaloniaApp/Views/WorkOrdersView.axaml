<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="AutoService.AvaloniaApp.Views.WorkOrdersView">
  <DockPanel>
    <StackPanel DockPanel.Dock="Top" Spacing="8">
      <TextBlock Classes="h1" Text="Заказ-наряды" />
      <TextBlock Classes="hint" Text="Администратор просматривает заказ-наряды. Создание и ремонт выполняет механик." />
      <WrapPanel>
        <TextBox Width="200" Text="{Binding Search}" Watermark="Клиент или госномер" Margin="0,0,8,8" />
        <TextBox Width="140" Text="{Binding Day}" Watermark="Дата дд.мм.гггг" Margin="0,0,8,8" />
        <ComboBox Width="160" ItemsSource="{Binding Statuses}" SelectedItem="{Binding Status}" Margin="0,0,8,8" />
        <ComboBox Width="200" ItemsSource="{Binding Mechanics}" SelectedItem="{Binding Mechanic}" PlaceholderText="Механик" Margin="0,0,8,8" />
        <Button Content="Найти" Command="{Binding SearchCommand}" Margin="0,0,8,8" />
        <ComboBox Width="80" ItemsSource="{Binding PageSizes}" SelectedItem="{Binding PageSize}" Margin="0,0,8,8" />
        <Button Content="Назад" Command="{Binding PreviousPageCommand}" Margin="0,0,8,8" />
        <Button Content="Дальше" Command="{Binding NextPageCommand}" Margin="0,0,8,8" />
        <TextBlock Text="{Binding PageText}" VerticalAlignment="Center" />
      </WrapPanel>
    </StackPanel>
    <TextBlock DockPanel.Dock="Bottom" Classes="error" Text="{Binding Error}" IsVisible="{Binding HasError}" />
    <DataGrid ItemsSource="{Binding Items}" IsReadOnly="True" AutoGenerateColumns="False">
      <DataGrid.Columns>
        <DataGridTextColumn Header="№" Binding="{Binding Id}" Width="60" />
        <DataGridTextColumn Header="Создан" Binding="{Binding CreatedAt}" Width="150" />
        <DataGridTextColumn Header="Статус" Binding="{Binding Status}" Width="140" />
        <DataGridTextColumn Header="Механик" Binding="{Binding Mechanic}" Width="*" />
        <DataGridTextColumn Header="Клиент" Binding="{Binding ClientName}" Width="*" />
        <DataGridTextColumn Header="Авто" Binding="{Binding Car}" Width="120" />
        <DataGridTextColumn Header="Услуга" Binding="{Binding Service}" Width="180" />
      </DataGrid.Columns>
    </DataGrid>
  </DockPanel>
</UserControl>
