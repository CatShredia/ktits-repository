<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:FirstAvalonMVVMProject.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="FirstAvalonMVVMProject.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="FirstAvalonMVVMProject">

        <Grid RowDefinitions="* Auto">
                <DataGrid  Grid.Row="0" ItemsSource="{Binding Users}" IsReadOnly="True" DoubleTapped="InputElement_OnDoubleTapped" Name="MainDataGridUsers">
                        <DataGrid.Columns>
                                <DataGridTextColumn Header="id" Binding="{Binding IdUser}"></DataGridTextColumn>
                                <DataGridTextColumn Header="FirstName" Binding="{Binding FirstName}"></DataGridTextColumn>
                                <DataGridTextColumn Header="SecondName" Binding="{Binding SecondName}"></DataGridTextColumn>
                                <DataGridTextColumn Header="Description" Binding="{Binding Description}"></DataGridTextColumn>
                        </DataGrid.Columns>
                </DataGrid>
                <Button Grid.Row="1" Click="Button_OnClick">Добавление</Button>
        </Grid>
</Window>
