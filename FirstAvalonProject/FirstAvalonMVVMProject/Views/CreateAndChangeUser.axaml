<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="FirstAvalonMVVMProject.Views.CreateAndChangeUser"
        Title="CreateAndChangeUser">
    
    <Grid ColumnDefinitions="Auto, *" RowDefinitions="Auto Auto Auto Auto" ColumnSpacing="10" RowSpacing="5" Margin="10">
        <!-- Фамилия -->
        <TextBlock Grid.Row="0" Grid.Column="0" Text="Фамилия"/>
        <TextBox Grid.Row="0" Grid.Column="1" Name="FistNameTextBox"/>

        <!-- Имя -->
        <TextBlock Grid.Row="1" Grid.Column="0" Text="Имя"/>
        <TextBox Grid.Row="1" Grid.Column="1" Name="SecondNameTextBox"/>

        <!-- Описание -->
        <TextBlock Grid.Row="2" Grid.Column="0" Text="Описание"/>
        <TextBox Grid.Row="2" Grid.Column="1" Name="DescriptionTextBox"/>

        <!-- Кнопка -->
        <Button Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2" Content="ОК" HorizontalAlignment="Left" Click="Button_OnClick"/>
    </Grid>
</Window>
