<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="FirstAvalonMVVMProject.Views.CreateAndChangeLoginWindow"
        Title="CreateAndChangeLoginWindow">
    <Grid>
        <Grid ColumnDefinitions="Auto, *" RowDefinitions="Auto Auto Auto Auto Auto" ColumnSpacing="10" RowSpacing="5"
              Margin="10">
            <!-- Логин -->
            <TextBlock Grid.Row="0" Grid.Column="0" Text="Логин" />
            <TextBox Grid.Row="0" Grid.Column="1" Name="LoginTextBox" />

            <!-- Пароль -->
            <TextBlock Grid.Row="1" Grid.Column="0" Text="Пароль" />
            <TextBox Grid.Row="1" Grid.Column="1" Name="PasswordTextBox" />

            <!-- Кнопка -->
            <Button Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2" Content="ОК" HorizontalAlignment="Left"
                    Click="Submit_Button" />
        </Grid>
    </Grid>
</Window>
