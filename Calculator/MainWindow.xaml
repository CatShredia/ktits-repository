<Window
    x:Class="CalculatorWPF.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Calculator"
    Width="300"
    Height="350">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--  Отображение результата  -->
        <TextBox
            x:Name="ResultTextBox"
            Grid.Row="0"
            Margin="10"
            Padding="5"
            FontSize="20"
            IsReadOnly="True"
            TextAlignment="Right" />

        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="*" />
                <RowDefinition Height="*" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!--  Кнопки  -->
            <Button
                x:Name="Button7"
                Grid.Row="0"
                Grid.Column="0"
                Margin="5"
                Click="NumberButton_Click"
                Content="7"
                FontSize="16" />
            <Button
                x:Name="Button8"
                Grid.Row="0"
                Grid.Column="1"
                Margin="5"
                Click="NumberButton_Click"
                Content="8"
                FontSize="16" />
            <Button
                x:Name="Button9"
                Grid.Row="0"
                Grid.Column="2"
                Margin="5"
                Click="NumberButton_Click"
                Content="9"
                FontSize="16" />
            <Button
                x:Name="ButtonDivide"
                Grid.Row="0"
                Grid.Column="3"
                Margin="5"
                Click="OperationButton_Click"
                Content="/"
                FontSize="16" />

            <Button
                x:Name="Button4"
                Grid.Row="1"
                Grid.Column="0"
                Margin="5"
                Click="NumberButton_Click"
                Content="4"
                FontSize="16" />
            <Button
                x:Name="Button5"
                Grid.Row="1"
                Grid.Column="1"
                Margin="5"
                Click="NumberButton_Click"
                Content="5"
                FontSize="16" />
            <Button
                x:Name="Button6"
                Grid.Row="1"
                Grid.Column="2"
                Margin="5"
                Click="NumberButton_Click"
                Content="6"
                FontSize="16" />
            <Button
                x:Name="ButtonMultiply"
                Grid.Row="1"
                Grid.Column="3"
                Margin="5"
                Click="OperationButton_Click"
                Content="*"
                FontSize="16" />

            <Button
                x:Name="Button1"
                Grid.Row="2"
                Grid.Column="0"
                Margin="5"
                Click="NumberButton_Click"
                Content="1"
                FontSize="16" />
            <Button
                x:Name="Button2"
                Grid.Row="2"
                Grid.Column="1"
                Margin="5"
                Click="NumberButton_Click"
                Content="2"
                FontSize="16" />
            <Button
                x:Name="Button3"
                Grid.Row="2"
                Grid.Column="2"
                Margin="5"
                Click="NumberButton_Click"
                Content="3"
                FontSize="16" />
            <Button
                x:Name="ButtonMinus"
                Grid.Row="2"
                Grid.Column="3"
                Margin="5"
                Click="OperationButton_Click"
                Content="-"
                FontSize="16" />

            <Button
                x:Name="Button0"
                Grid.Row="3"
                Grid.Column="0"
                Margin="5"
                Click="NumberButton_Click"
                Content="0"
                FontSize="16" />
            <Button
                x:Name="ButtonDot"
                Grid.Row="3"
                Grid.Column="1"
                Margin="5"
                Click="NumberButton_Click"
                Content="."
                FontSize="16" />
            <Button
                x:Name="ButtonEquals"
                Grid.Row="3"
                Grid.Column="2"
                Margin="5"
                Click="EqualsButton_Click"
                Content="="
                FontSize="16" />
            <Button
                x:Name="ButtonPlus"
                Grid.Row="3"
                Grid.Column="3"
                Margin="5"
                Click="OperationButton_Click"
                Content="+"
                FontSize="16" />
        </Grid>
    </Grid>
</Window>