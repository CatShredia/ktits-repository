<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:parts="clr-namespace:StudyProject.Parts"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="StudyProject.MainWindow"
        Title="StudyProject"
        Icon="avares://StudyProject/Assets/icon.ico"
        WindowState="Maximized">
    <Grid RowDefinitions="12* 78* 10*">

        <Grid Grid.Row="0">
            <parts:Header></parts:Header>
        </Grid>

        <Grid Grid.Row="1" Margin="10" Name="ContentGrid">
        </Grid>

        <Grid Grid.Row="2">
            <parts:Footer></parts:Footer>
        </Grid>


    </Grid>
</Window>