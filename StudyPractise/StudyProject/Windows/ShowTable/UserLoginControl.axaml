<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="StudyProject.Windows.ShowTable.UserLoginControl">
    <Grid RowDefinitions="Auto Auto Auto">
        <TextBlock Grid.Row="0">Users</TextBlock>
        <ScrollViewer MaxHeight="1000"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Grid.Row="1">
            <DataGrid Name="UserDataGrid"
                      IsReadOnly="True"
                      AutoGenerateColumns="False"
                      DoubleTapped="EditUserLogin">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="ID" Binding="{Binding Id}" />
                    <DataGridTextColumn Header="Name" Binding="{Binding Name}" />
                    <DataGridTextColumn Header="Email" Binding="{Binding Email}" />
                    <DataGridTextColumn Header="Role ID" Binding="{Binding IdRole}" />
                    <DataGridTextColumn Header="Login" Binding="{Binding Logins[0].Login1, FallbackValue='–'}" />
                    <DataGridTemplateColumn Header="" Width="50">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Click="DeleteUserLogin">
                                    <Image Source="avares://StudyProject/Assets/bin.png"
                                           Cursor="Hand" />
                                </Button>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </ScrollViewer>
        <Button Grid.Row="2" Click="CreateNewUserLogin">Add New</Button>
    </Grid>
</UserControl>