<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="StudyProject.Windows.ShowTable.EmployeeControl">
    <Grid RowDefinitions="Auto Auto Auto Auto">
        <TextBlock Grid.Row="0" Margin="10">Employees</TextBlock>
        <TextBlock Grid.Row="1" Margin="10" Foreground="Red" Name="MessageBox"></TextBlock>
        <Button Grid.Row="2" Click="CreateNewEmployee">Add New</Button>
        <ScrollViewer MaxHeight="1000" 
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Grid.Row="3">
            <DataGrid Name="EmployeeDataGrid"
                      IsReadOnly="True"
                      AutoGenerateColumns="False"
                      DoubleTapped="EditEmployee">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Tab Num" Binding="{Binding TabNumEmployee}" />
                    <DataGridTextColumn Header="Fullname" Binding="{Binding Fullname}" />
                    <DataGridTextColumn Header="Position" Binding="{Binding PositionEmp}" />
                    <DataGridTextColumn Header="Salary" Binding="{Binding Salary}" />
                    <DataGridTextColumn Header="Dept ID" Binding="{Binding IdDepart}" />
                    <DataGridTextColumn Header="Chief Tab" Binding="{Binding Chief}" />
                    <DataGridTemplateColumn Header="" Width="50">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Click="DeleteEmployee">
                                    <Image Source="avares://StudyProject/Assets/bin.png"
                                           Cursor="Hand" />
                                </Button>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </ScrollViewer>
    </Grid>
</UserControl>