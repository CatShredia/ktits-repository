<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="StudyProject.Windows.ShowTable.StudentControl">
    <Grid RowDefinitions="Auto Auto Auto Auto Auto">
        <TextBlock Grid.Row="0" Margin="10">Students</TextBlock>
        <TextBox Grid.Row="1" Name="SearchBox"  Watermark="Search..." TextChanged="OnSearchTextChanged" Margin="10"/>
        <TextBlock Grid.Row="2" Margin="10" Foreground="Red" Name="MessageBox"></TextBlock>
        <ScrollViewer MaxHeight="1000"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Grid.Row="3">
            <DataGrid Name="StudentDataGrid"
                      IsReadOnly="True"
                      AutoGenerateColumns="False"
                      DoubleTapped="EditStudent">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Reg Number" Binding="{Binding RegNumber}" />
                    <DataGridTextColumn Header="Fullname" Binding="{Binding Fullname}" />
                    <DataGridTextColumn Header="Specialty ID" Binding="{Binding IdSpeciality}" />
                    <DataGridTemplateColumn Header="" Width="50">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Click="DeleteStudent">
                                    <Image Source="avares://StudyProject/Assets/bin.png"
                                           Cursor="Hand" />
                                </Button>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </ScrollViewer>
        <Button Grid.Row="4" Click="CreateNewStudent">Add New</Button>
    </Grid>
</UserControl>