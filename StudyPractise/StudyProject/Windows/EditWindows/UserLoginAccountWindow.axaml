<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        x:Class="StudyProject.Windows.EditWindows.UserLoginAccountWindow"
        Title="Edit User"
        Icon="avares://StudyProject/Assets/icon.ico"
        >
    <ScrollViewer>
        <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto, Auto" Margin="15">
            <TextBlock Grid.Row="6" Text="Login:" />
            <TextBox Grid.Row="7" Name="LoginBox" />
            <TextBlock Grid.Row="8" Text="Password:" />
            <TextBox Grid.Row="9" Name="PasswordBox" />
            <TextBlock Grid.Row="10" Name="ErrorMessage" Foreground="Red" TextWrapping="Wrap" />
            <StackPanel Orientation="Horizontal" Grid.Row="11" HorizontalAlignment="Right" Margin="0,15,0,0">
                <Button Background="#1bfce2" Content="OK" Click="OnSave" MinWidth="80" Margin="0,0,10,0" />
                <Button Background="#1bfce2" Content="Cancel" Click="OnCancel" MinWidth="80" />
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Window>