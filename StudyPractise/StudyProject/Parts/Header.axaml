<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="StudyProject.Parts.Header">
    <Grid ColumnDefinitions="50* 50*">
        <Grid Margin="10" ColumnDefinitions="Auto Auto Auto Auto" HorizontalAlignment="Left" VerticalAlignment="Center">
            <Button Click="ToClearWindow" Background="Transparent"
                    BorderBrush="Transparent">
                <Grid ColumnDefinitions="Auto Auto" HorizontalAlignment="Left" VerticalAlignment="Center">
                    <Image Grid.Column="0" Margin="10"
                           Source="avares://StudyProject/Assets/icon.png" Stretch="UniformToFill"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" TextAlignment="Center" HorizontalAlignment="Center"
                               VerticalAlignment="Center">
                        SmartFish
                    </TextBlock>
                </Grid>
            </Button>


            <Grid Grid.Column="2" ColumnDefinitions="Auto Auto Auto Auto Auto Auto">
                <Button Margin="5" IsVisible="false" Grid.Column="0" Click="ToExamTable" Name="ExamButton">Exams</Button>
                <Button Margin="5" IsVisible="false" Grid.Column="1" Click="ToSpecialtyTable" Name="SpecialtyButton">Specialty</Button>
                <Button Margin="5" IsVisible="false" Grid.Column="2" Click="ToDepartmentTable" Name="DepartmentButton">Department</Button>
                <Button Margin="5" IsVisible="false" Grid.Column="3" Click="ToEmployeeTable" Name="EmployeeButton">Employee</Button>
                <Button Margin="5" IsVisible="false" Grid.Column="4" Click="ToStudentTable" Name="StudentButton">Student</Button>
                <Button Margin="5" IsVisible="false" Grid.Column="5" Click="ToDisciplineTable" Name="DisciplineButton">Discipline</Button>
            </Grid>
        </Grid>

        <Grid Grid.Column="1" Margin="10" ColumnDefinitions="Auto Auto Auto Auto" HorizontalAlignment="Right"
              VerticalAlignment="Center">
            <Grid Grid.Column="3" ColumnDefinitions="Auto Auto Auto Auto">
                <Button Margin="5" IsVisible="false" Grid.Column="0" Name="ProfileButton" Click="ToProfile"
                        Content="Profile">
                </Button>
                <Button Margin="5" IsVisible="false" Grid.Column="1" Click="ToLogin" Name="LoginButton">Login</Button>
                <Button Margin="5" IsVisible="false" Grid.Column="2" Click="ToRegister" Name="RegisterButton">Register</Button>
                <Button Margin="5" IsVisible="false" Grid.Column="3" Click="ToOut" Name="OutButton" Background="Transparent"
                        BorderBrush="Transparent">
                    <Image Margin="10"
                           Source="avares://StudyProject/Assets/enter.png" Stretch="UniformToFill"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center" 
                           Width="30" Height="30"/>
                </Button>
            </Grid>
        </Grid>
    </Grid>
</UserControl>