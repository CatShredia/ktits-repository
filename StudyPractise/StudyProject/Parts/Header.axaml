<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="StudyProject.Parts.Header">
    <Grid>
        <Grid Margin="10" ColumnDefinitions="Auto * Auto" HorizontalAlignment="Left" VerticalAlignment="Center">
            <TextBlock Grid.Column="0" TextAlignment="Center">StudyPractiseProject</TextBlock>
            <!-- <Image Grid.Column="1" Margin="10" Height="75" Width="75"  -->
            <!--        Source="avares://StudyProject/Assets/logo.ico" Stretch="UniformToFill" HorizontalAlignment="Center" VerticalAlignment="Center"/> -->
            
            <TextBlock Grid.Column="1"></TextBlock>
            
            <Grid Grid.Column="2">
                <Button Click="ToExamTable">Exams</Button>
                <Button Click="ToSpecialtyTable">Specialty</Button>
                <Button Click="ToDepartmentTable">Department</Button>
                <Button Click="ToEmployeeTable">Employee</Button>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
